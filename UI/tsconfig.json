{
    "compilerOptions": {
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "es2020",
        "lib": ["dom", "dom.iterable", "es2020"],
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": [
        "src/javascript/**/*",
        "stories/**/*",
        ".storybook/**/*",
        "components/*"
    ],
    "exclude": ["node_modules"]
}
