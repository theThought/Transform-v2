{
    "compilerOptions": {
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "es2019"
    },
    "include": [
        "src/javascript/**/*",
        "stories/**/*",
        ".storybook/**/*",
        "components/*"
    ],
    "exclude": ["node_modules"]
}
