{
    "compilerOptions": {
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "es2020",
        "lib": ["dom", "dom.iterable", "es2020"],
        "skipLibCheck": true
    },
    "include": ["src/javascript/**/*", "components/*"],
    "exclude": ["node_modules"]
}
