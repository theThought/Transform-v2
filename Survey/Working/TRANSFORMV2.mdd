section ListPaperDay

	PageToDisplay.response = "LstPaperDay"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	'PageToAsk.layouttemplate = "XML.htm"
	
	set customProperties = CreateObject()
	with customProperties
		.listsize = 10
		.jumptofirstletter = true
		.filter= "starts"
		.noitemsinlist = "Nothing left"
	end with
	
	PageToAsk.categories.Mon.label.style.align = alignments.alLeft
	for iterationLoop = 0 to LstPaperDay.Count -1 
		set iterationItem = LstPaperDay[iterationLoop]
		
		customProperties.listsize = iterationLoop + 3
		
		jsonProperties = JsonSerialize(customProperties)
		
		iterationItem["WhichPaper"].Style.Color = jsonProperties
	Next
	
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

