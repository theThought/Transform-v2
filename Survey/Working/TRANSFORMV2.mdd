e="4"><variable name="TabFilters" type="3" min="1" mintype="3" max="1" maxtype="3"/></version></versions></variable><variable id="d4020474-507c-4dda-b557-253c4b423a31" name="ExitSub" type="0"><labels context="LABEL"><versions><DIFF OP="ADD" name="4" Index="0"><text context="QUESTION" xml:lang="en-US">dummy question for an Exit</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">dummy question for an Exit</text></labels><versions><version name="4"><variable name="ExitSub" type="0"/></version></versions></variable><variable id="2f4cfa83-413c-43b6-9af3-bb61561967d9" name="PageToDisplay" type="2" max="50" maxtype="3" no-casedata="-1"><labels context="LABEL"><versions><DIFF OP="ADD" name="4" Index="0"><text context="QUESTION" xml:lang="en-US"></text></DIFF></versions><text context="QUESTION" xml:lang="en-US"></text></labels><versions><version name="4"><variable name="PageToDisplay" type="2" max="50" maxtype="3" no-casedata="-1"/></version></versions></variable><variable id="439176f9-ee19-4b73-96cd-437990bdcf2a" name="ClosedInstructions" type="0"><templates><versions><DIFF OP="ADD" name="4" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question.htm" type="8" context="Question"/></templates><labels context="LABEL"><versions><DIFF OP="ADD" name="4" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;Closed Questions&lt;/h2&gt;&lt;p&gt;These are questions where the respondent has to select an option rather than write one.  Today there are two broad categories of response type based on the way options are presented for selection:&lt;ul&gt;&lt;li&gt;choice questions (radio buttons and checkboxes)&lt;/li&gt;&lt;li&gt;list questions (lists, dropdowns, combboxes)&lt;/li&gt;&lt;/ul&gt;.&lt;/p&gt;</text></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;p&gt;These are questions where the respondent has to select an option rather than write one.  Today there are two broad categories of response type based on the way options are presented for selection:&lt;ul&gt;&lt;li&gt;choice questions (radio buttons and checkboxes)&lt;/li&gt;&lt;li&gt;list questions (lists, dropdowns, combboxes)&lt;/li&gt;&lt;/ul&gt;.&lt;/p&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;p&gt;These are questions where the respondent has to select an option rather than write one.  Today there are two broad categories of response type based on the way options are presented for selection:&lt;ul&gt;&lt;li&gt;choice questions (radio buttons and checkboxes)&lt;/li&gt;&lt;li&gt;list questions (lists, dropdowns, combboxes)&lt;/li&gt;&lt;/ul&gt;.&lt;/p&gt;</text></labels><versions><version name="4"><variable name="ClosedInstructions" type="0"/></version></versions><properties><versions><DIFF OP="ADD" name="44" Index="0"><property name="CurrentTab" value="ClosedInstructions" type="8" context="Question"/></DIFF></versions><property name="CurrentTab" value="ClosedInstructions" type="8" context="Question"/></properties></variable><variable id="e3a6e86f-7d90-4823-bc3f-801942cc9c6b" name="OpenInstructions" type="0"><templates><versions><DIFF OP="ADD" name="4" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question.htm" type="8" context="Question"/></templates><labels context="LABEL"><versions><DIFF OP="ADD" name="4" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;Open Questions&lt;/h2&gt;&lt;p&gt;These are questions where the respondent has to provide a value, date or text.  Most entries are a single line in height (used of short phrases up to a single short sentance and single values/dates), there is an option for multi-line entries where a text response is expected to be a long sentance, paragraph or more.&lt;/p&gt;</text></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;p&gt;These are questions where the respondent has to provide a value, date or text.  Most entries are a single line in height (used of short phrases up to a single short sentance and single values/dates), there is an option for multi-line entries where a text response is expected to be a long sentance, paragraph or more.&lt;/p&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;p&gt;These are questions where the respondent has to provide a value, date or text.  Most entries are a single line in height (used of short phrases up to a single short sentance and single values/dates), there is an option for multi-line entries where a text response is expected to be a long sentance, paragraph or more.&lt;/p&gt;</text></labels><versions><version name="4"><variable name="OpenInstructions" type="0"/></version></versions><properties><versions><DIFF OP="ADD" name="44" Index="0"><property name="CurrentTab" value="OpenInstructions" type="8" context="Question"/></DIFF></versions><property name="CurrentTab" value="OpenInstructions" type="8" context="Question"/></properties></variable><variable id="9def5f0b-6ff9-4727-b5aa-a791c6f890b9" name="HorizontalInstructions" type="0"><templates><versions><DIFF OP="ADD" name="4" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question.htm" type="8" context="Question"/></templates><labels context="LABEL"><versions><DIFF OP="ADD" name="4" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;Horizontal Questions&lt;/h2&gt;&lt;p&gt;Some question types are based on an open response but provide choices to the user that make them look like closed questions.  This includes:&lt;ul&gt;&lt;li&gt;sliders&lt;/li&gt;&lt;li&gt;scales&lt;/li&gt;&lt;/ul&gt;.&lt;/p&gt;</text></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;p&gt;Some question types are based on an open response but provide choices to the user that make them look like closed questions.  This includes:&lt;ul&gt;&lt;li&gt;sliders&lt;/li&gt;&lt;li&gt;scales&lt;/li&gt;&lt;/ul&gt;.&lt;/p&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;p&gt;Some question types are based on an open response but provide choices to the user that make them look like closed questions.  This includes:&lt;ul&gt;&lt;li&gt;sliders&lt;/li&gt;&lt;li&gt;scales&lt;/li&gt;&lt;/ul&gt;.&lt;/p&gt;</text></labels><versions><version name="4"><variable name="HorizontalInstructions" type="0"/></version></versions><properties><versions><DIFF OP="ADD" name="44" Index="0"><property name="CurrentTab" value="HorizontalInstructions" type="8" context="Question"/></DIFF></versions><property name="CurrentTab" value="HorizontalInstructions" type="8" context="Question"/></properties></variable><variable id="cf18aabe-9817-4681-b449-7fb3d99fa9fc" name="Codes" type="3" usagetype="528"><labels context="LABEL"><versions><DIFF OP="ADD" name="4" Index="0"><text context="QUESTION" xml:lang="en-US">Codes</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Codes</text></labels><categories global-name-space="-1"><versions><DIFF OP="ADD" name="4" Index="0" item="c5cfccfd-65e7-4a04-9e22-756dbc74624c"/><version name="4"><categories global-name-space="-1"/></version></versions><deleted/><category id="_c5cfccfd-65e7-4a04-9e22-756dbc74624c" name="noanswer" fixed="-1" nofilter="-1" missing="noanswer" exclusive="-1"><labels context="LABEL"><versions><DIFF OP="ADD" name="4" Index="0"><text context="QUESTION" xml:lang="en-US"></text></DIFF></versions><text context="QUESTION" xml:lang="en-US"></text></labels><versions><version name="4"><category name="noanswer" fixed="-1" nofilter="-1" missing="noanswer" exclusive="-1"/></version></versions></category></categories><versions><version name="4"><variable name="Codes" type="3" usa