section Messages
 	PageToDisplay.response = "Messages"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	Messages.Errors.Clear()
	
	Messages.Errors.AddNew("DummyError", DummyError.Label)
	Messages.Banners.AddNew("Instruction", "This is a simple instruction, it is usually utilised to provide one line guideance to respondents, helping them understand how to answer the question")
	Messages.Banners.AddNew("Warning", "This is a less used feature, it warns a respondent about something that may affect the way they answer a question")

	CreateInformationPopup(Messages, "More Information", "&lt;p&gt;More complex information can be shown in an expand/collapse format.&lt;/p&gt;&lt;p&gt;This is used to provide the user with more information about an aspect of the question such as terms used within the question.&lt;/p&gt; ")
	
'IOM.LayoutTemplate = "xml.htm"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

section LocalStorage_Write
	PageToDisplay.response = "WriteToLocalStorage"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
	WriteFirstName.response = "Kevin"
	WriteSurname.response = "Gray"

	set customProperties = CreateObject()
	set customProperties.write = CreateObject()
	with customProperties.write
		.destination = "LocalStorage"
		.name = "firstname"
	end with
	jsonProperties = JsonSerialize(customProperties)
	WriteFirstName.Style.Color = jsonProperties
	
	with customProperties.write
		.name = "surname"
	end with
	jsonProperties = JsonSerialize(customProperties)
	WriteSurname.Style.Color = jsonProperties
'AddCustomProperties(WriteFirstName, "WriteFirstName", "{'write':{'destination':'LocalStorage','name':'firstname'}}", "replace")
'AddCustomProperties(WriteSurname, "WriteSurname", "{'write':{'destination':'LocalStorage','name':'surname'}}", "replace")

	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

