<DIFF OP="ADD" name="1" Index="0"><text context="QUESTION" xml:lang="en-US"></text></DIFF></versions><text context="QUESTION" xml:lang="en-US"></text></labels><versions><version name="1"><category name="noanswer" fixed="-1" nofilter="-1" missing="noanswer" exclusive="-1"/></version></versions></category></categories><versions><version name="1"><variable name="Codes" usagetype="528" type="3"/></version><version name="2"><variable name="Codes" type="3" usagetype="528"/></version></versions></variable><variable id="db82a96c-33ef-4d06-87fa-8e8f05e58a0b" name="question4" type="2" max="20" maxtype="3"><labels context="LABEL"><versions><DIFF OP="ADD" name="1" Index="0"><text context="QUESTION" xml:lang="en-US">question 4</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">question 4</text></labels><helperfields id="3ade3a50-ffdf-4c94-b372-5e8807bff51e" name="@helperfields" global-name-space="-1"><versions><DIFF OP="ADD" name="1" Index="0" item="7cc4663e-7636-4b07-88e8-26a768f03efc"/></versions><deleted/><variable id="_7cc4663e-7636-4b07-88e8-26a768f03efc" name="Codes" ref="7cc4663e-7636-4b07-88e8-26a768f03efc"/></helperfields><versions><version name="1"><variable name="question4" type="2" max="20" maxtype="3"/></version></versions></variable><variable id="7cc4663e-7636-4b07-88e8-26a768f03efc" name="Codes" type="3" usagetype="528"><labels context="LABEL"><versions><DIFF OP="ADD" name="1" Index="0"><text context="QUESTION" xml:lang="en-US">Codes</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Codes</text></labels><categories global-name-space="-1"><versions><DIFF OP="ADD" name="1" Index="0" item="9f02eeb7-82da-47e4-a9e7-45163adce86e"/><version name="1"><categories global-name-space="-1"/></version></versions><deleted/><category id="_9f02eeb7-82da-47e4-a9e7-45163adce86e" name="noanswer" fixed="-1" nofilter="-1" missing="noanswer" exclusive="-1"><labels context="LABEL"><versions><DIFF OP="ADD" name="1" Index="0"><text context="QUESTION" xml:lang="en-US"></text></DIFF></versions><text context="QUESTION" xml:lang="en-US"></text></labels><versions><version name="1"><category name="noanswer" fixed="-1" nofilter="-1" missing="noanswer" exclusive="-1"/></version></versions></category></categories><versions><version name="1"><variable name="Codes" usagetype="528" type="3"/></version><version name="2"><variable name="Codes" type="3" usagetype="528"/></version></versions></variable><variable id="197ad9bc-0d95-49ee-b196-8d0300308ccf" name="StripInstructions" type="0"><templates><versions><DIFF OP="ADD" name="1" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question.htm" type="8" context="Question"/></templates><labels context="LABEL"><versions><DIFF OP="ADD" name="1" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;Welcome to this tabstrip demonstration&lt;/h2&gt;&lt;p&gt;This is Tabstrip 1, its purpose is to provide an alternative method of navigation between survey pages.  It can be used in conjunction with traditional navigation buttons (next/previous) or it can replace them entirely.&lt;/p&gt;&lt;p&gt;The tabstrip is based on a choice question (single-answer).  When a user taps on a tab they select that option in the question.  The form is then sumbitted and Dimensions uses the selection to determine the next page to visit.&lt;/p&gt;</text></DIFF><DIFF OP="DEL" name="76" Index="0"/><DIFF OP="ADD" name="76" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;Using Tabstrips&lt;/h2&gt;&lt;p&gt;This is Tabstrip 1, its purpose is to provide an alternative method of navigation between survey pages.  It can be used in conjunction with traditional navigation buttons (next/previous) or it can replace them entirely.&lt;/p&gt;&lt;p&gt;The tabstrip is based on a choice question (single-answer).  When a user taps on a tab they select that option in the question.  The form is then sumbitted and Dimensions uses the selection to determine the next page to visit.&lt;/p&gt;&lt;p&gt; In situations where the user views a page, fails to complete mandatory questions and then clicks on another tab to move away, the solution will look at the location of the new tab compared to the current one.  If the new tab is to the left it uses the previous button to navigate away.  If it is to the right it uses the next button; this causes validation to occur and for the user to be returned to the original tab to complete the required actions.&lt;/p&gt;</text></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;p&gt;Not all questions ask questions; some questions present information to the respondent.&lt;/p&gt;&lt;p&gt;information questions can be standalone or can be used in conjunction with other interactive questions on the page. It is also possible to combine presenting and answering in a single question where the presenting functionality is part of the question text.&lt;/p&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;p&gt;Not all questions ask questions; some questions present information to the respondent.&lt;/p&gt;&lt;p&gt;information questions can be standalone or can be used in conjunction with other interactive questions on the page. It is also possible to combine presenting and answering in a single question where the presenting functionality is part of the question text.&lt;/p&gt;</text></labels><versions><version name="1"><variable name="StripInstructions" type="0"/></version></versions><notes><versions><DIFF OP="ADD" name="4" Index="0"><property name="5@note1" value="------------------------" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="4" Index="1"><property name="5@note2" value=" Instructions" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="4" Index="2"><property name="5@note3" value="========================" type="8" context="Question"/></DIFF><DIFF OP="DEL" name="32" Index="0"/><DIFF OP="DEL" name="32" Index="0"/><DIFF OP="DEL" name="32" Index="0"/></versions></notes><properties><versions><DIFF OP="ADD" name="44" Index="0"><property name="CurrentTab" value="Presenting" type="8" context="Question"/></DIFF></versions><property name="CurrentTab" value="Presenting" type="8" context="Question"/></properties></variable><variable id="723e39bd-a99c-47dd-8f0c-c250df4f3076" name="StripOneSize" type="3" max="1" maxtype="3"><styles><versions><DIFF OP="ADD" name="1" Index="0"><property name="BgColor" value="choice:" type="8" context="Question"/></DIFF></versions><property name="BgColor" value="choice:" type="8" context="Question"/></styles><templates><versions><DIFF OP="ADD" name="1" Index="0"><property name="Question" value="question 2-column.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question 2-column.htm" type="8" context="Question"/></templates><labels context="LABEL"><versions><DIFF OP="ADD" name="1" Index="0"><text context="QUESTION" xml:lang="en-US">What size should your tabs be:</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">What size should your tabs be:</text></labels><categories global-name-space="-1"><versions><DIFF OP="ADD" name="1" Index="0" item="5bcdd991-7c98-4524-9ad5-f7db3fa26588"/><DIFF OP="ADD" name="1" Index="1" item="09065346-8876-4f54-a068-2938141840d0"/><version name="1"><categories global-name-space="-1"/></version></versions><deleted/><category id="_5bcdd991-7c98-4524-9ad5-f7db3fa26588" name="sizetofit"><labels context="LABEL"><versions><DIFF OP="ADD" name="1" Index="0"><text context="QUESTION" xml:lang="en-US">Each tab should be the size of the caption text</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Each tab should be the size of the caption text</text></labels><versions><version name="1"><category name="sizetofit"/></version></versions></category><category id="_09065346-8876-4f54-a068-2938141840d0" name="samesize"><labe