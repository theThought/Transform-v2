section Tabletotals

section PainRelief
	dim topHeadings, visibilityRule, exclusiveArray[1]
	dim visibilitySaturday, visibilitySunday

	PageToDisplay.response = "PainReliefPage"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	Onedayweekend.Response.Initial = {twoday}
'AddCustomProperties(PainRelief, "PainRelief", "{'caption':{'content':'Pain Relief'},'totals':{'rows':{'visible':true,'caption':{'content':'Consumption'},'exceptions':[]},'columns':{'visible':false,'exceptions':[1]}}}", "replace")
'AddCustomProperties(PainRelief, "dosesgiven", "{'type':'number'}", "add")
'AddCustomProperties(PainRelief, "Monday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Tuesday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Wednesday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Thursday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Friday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Saturday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Sunday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "PainRelief", "{'topheadings':[{'caption':'','colspan':1},{'caption':'Week','colspan':5},{'caption':'Weekend','colspan':2},{'caption':'Total','colspan':1}]}", "add")

	topHeadings = "{'topheadings':[{'caption':'','colspan':2},{'caption':'Week','colspan':5},{'caption':'Weekend','colspan':2},{'caption':'Total','colspan':1}]}"
	topHeadings = topHeadings.replace("'", """")

	visibilityRule = CreateVisibilityRule("OfferPainRelief.containsAny('Yes')")
	set customProperties = CreateObject()
	set customProperties.labels = CreateObject()
	customProperties.labels.pre = "definitely won't"
	customProperties.labels.post = "definitely will"
	set customProperties.visible = CreateObject()
	with customProperties.visible
		.collapse = true
		.rules = visibilityRule
	end with

	jsonProperties = JsonSerialize(customProperties)
	FuturePainRelief.Style.Color = jsonProperties
	FuturePainRelief.MustAnswer = false
	
	set customProperties = CreateObject()
	set customProperties.balance = CreateObject()
	customProperties.balance.state = true
	
	jsonProperties = JsonSerialize(customProperties)
	OfferPainRelief.style.color = jsonProperties
	OfferPainRelief.Response.Initial = {Yes}

	for each currentIteration in PainRelief
		iterationName = currentIteration.questionName 
'		currentIteration.dosesgiven.MustAnswer = false
'		currentIteration.Monday.MustAnswer = false
'		currentIteration.Tuesday.MustAnswer = false
'		currentIteration.Wednesday.MustAnswer = false
'		currentIteration.Thursday.MustAnswer = false
'		currentIteration.Friday.MustAnswer = false
'		currentIteration.Saturday.MustAnswer = false
'		currentIteration.Sunday.MustAnswer = false
		
	set customProperties = CreateObject()
	set customProperties.showspinner = true
	jsonProperties = JsonSerialize(customProperties)
		
		currentIteration.Monday.Style.Color = jsonProperties
		currentIteration.Tuesday.Style.Color = jsonProperties
		currentIteration.Wednesday.Style.Color = jsonProperties
		currentIteration.Thursday.Style.Color = jsonProperties
		currentIteration.Friday.Style.Color = jsonProperties
		
		set visibilitySaturday = CreateObject()
		visibilitySaturday.collapse = true
		visibilitySaturday.rules = CreateVisibilityRule(MakeString("PainRelief_Q", iterationName, "_QSunday.answerCount() &gt; 0", " and OneDayWeekend.containsAny('oneday')"))
		customProperties.invisible = visibilitySaturday
		jsonProperties = JsonSerialize(customProperties)
		currentIteration.Saturday.Style.Color = jsonProperties

		set visibilitySunday = CreateObject()
		visibilitySunday.collapse = true
		visibilitySunday.rules = CreateVisibilityRule(MakeString("PainRelief_Q", iterationName, "_QSaturday.answerCount() &gt; 0", " and OneDayWeekend.containsAny('oneday')"))
		customProperties.invisible = visibilitySunday

		jsonProperties = JsonSerialize(customProperties)
		currentIteration.Sunday.Style.Color = jsonProperties
	next
	
	set customProperties = JsonDeserialize(topHeadings)
	set customProperties.caption = CreateObject()
	set customProperties.caption.content = "Pain Relief"
	set customProperties.totals = CreateObject()
	set customProperties.totals.rows = CreateObject()
	customProperties.totals.rows.visible = true
	set customProperties.totals.rows.caption = CreateObject()
	customProperties.totals.rows.caption.align = "left"
	customProperties.totals.rows.caption.width = "5em"
	customProperties.totals.rows.width = "5em"
	customProperties.totals.rows.align = "right"
	customProperties.totals.rows.caption.content = "Consumption"
'	exclusiveArray[0] = 1
'	set customProperties.totals.rows.exceptions = exclusiveArray
	
	set customProperties.totals.columns = CreateObject()
	customProperties.totals.columns.visible = true
	customProperties.totals.columns.width = "5em"
 	customProperties.totals.columns.align = "right"
 	set customProperties.totals.columns.caption = CreateObject()
	customProperties.totals.columns.caption.align = "left"
	customProperties.totals.columns.caption.width = "7em"
	customProperties.totals.columns.caption.content = "Not visible"
	set customProperties.totals.columns.exceptions = exclusiveArray
	set customProperties.visible = CreateObject()
	with customProperties.visible
		.collapse = true
		.rules = visibilityRule
	end with
	
	jsonProperties = JsonSerialize(customProperties)
	
	PainRelief.Style.Color = jsonProperties
'	PageToAsk.layouttemplate = "XML.htm"
	PageToAsk.ask()

	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if	
end section

section Complextotals
	PageToDisplay.response = "ComplexTotals"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

'AddCustomProperties(grid5_rowtotal_diffpostlabel_percol, "grid5_rowtotal_diffpostlabel_percol", "{'cellshading':{'rowheader':true, 'columnheader':true, 'altrows':true}, 'totals':{'columns':{'visible':false, 'exceptions':[1]}, 'rows':{'visible':true, 'caption':{'content':'Total','align':'right','width':'8em'}, 'labels':{'post':'" + IOM.Questions.lperc_info.Label + "'}}}}", "replace")
'AddCustomProperties(grid5_rowtotal_diffpostlabel_percol, "tot", "{'type':'number', labels:{'post':'pts'}}", "add")
'AddCustomProperties(grid5_rowtotal_diffpostlabel_percol, "slice1", "{'type':'number', labels:{'post':'" + IOM.Questions.lperc_info.label + "'}}", "add")
'AddCustomProperties(grid5_rowtotal_diffpostlabel_percol, "slice2", "{'type':'number', labels:{'post':'" + IOM.Questions.lperc_info.label + "'}}", "add")
'AddCustomProperties(grid5_rowtotal_diffpostlabel_percol, "slice3", "{'type':'number', labels:{'post':'" + IOM.Questions.lperc_info.label + "'}}", "add")
'AddCustomProperties(grid5_rowtotal_diffpostlabel_percol, "slice4", "{'type':'number', labels:{'post':'" + IOM.Questions.lperc_info.label + "'}}", "add")
'AddCustomProperties(grid5_rowtotal_diffpostlabel_percol, "slice5", "{'type':'number', labels:{'post':'" + IOM.Questions.lperc_info.label + "'}}", "add")
	
	set customProperties =  createObject()
	set customProperties.cellshading = createObject()
	with customProperties.cellshading
		.rowheader = true
		.columnheader = true
		.altrows = true
	end with
	set customProperties.totals = createObject()
	with customProperties.totals
		set .columns = CreateObject()
		.columns.visible = false
		.exceptions = MakeArray(1)
		
		set .rows = CreateObject()
		.rows.visible = true
		.rows.width = "5em"
		set .rows.caption = createObject()
		.rows.caption.content = "Totals"
		.rows.caption.align = "left"
		.rows.caption.width = "5em"
		.rows.labels = CreateObject()
		.rows.labels.post = "%"
	end with
	set customProperties.labels = CreateObject()
	customProperties.labels.post = IOM.Questions.lperc_info.Label
	
	jsonProperties = JsonSerialize(customProperties)
	ComplexTotals.Style.Color = jsonProperties

	for each currentIteration in ComplexTotals
		currentIteration.tot.MustAnswer = false
		currentIteration.slice1.MustAnswer = false
		currentIteration.slice2.MustAnswer = false
		currentIteration.slice3.MustAnswer = false
		currentIteration.slice4.MustAnswer = true
		currentIteration.slice5.MustAnswer = false
		
		currentIteration.tot.Response  = 50
		currentIteration.slice1.Response.initial = 20
		currentIteration.slice2.Response.initial = 5
		currentIteration.slice3.Response.initial = 12
		currentIteration.slice4.Response.initial = 25
		currentIteration.slice5.Response.initial = 7
		
		set customProperties = CreateObject()
		set customProperties.labels = CreateObject()
		customProperties.labels.post = "pts"
		
		jsonProperties = JsonSerialize(customProperties)
		currentIteration.tot.Style.Color = jsonProperties

		set customProperties = CreateObject()
		set customProperties.labels = CreateObject()
		customProperties.labels.post = IOM.Questions.lperc_info.label	
		customProperties.separator = false
		jsonProperties = JsonSerialize(customProperties)
	
		currentIteration.slice1.Style.Color = jsonProperties
		currentIteration.slice2.Style.Color = jsonProperties
		currentIteration.slice3.Style.Color = jsonProperties
		currentIteration.slice4.Style.Color = jsonProperties
		currentIteration.slice5.Style.Color = jsonProperties
	Next
	
'	PageToAsk.layouttemplate = "XML.htm"
	PageToAsk.ask()

	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section


