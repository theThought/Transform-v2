Section Buttons


Section ActionButtons1
dim optionProperties
dim ActionCategories
dim ActionsBanner
	IOM.Title = "Action Buttons"
	IOM.Banners["pageHeader"].Text = "Action Buttons"
	
	ActionsStarted.response = 0
	ActionsCompleted.response = 0
	ActionButtons_Workings.Response = true
	ActionButtons_Shadow.Response = {New,Done}
	
	PageToDisplay.response = "ActionButtons_Page1"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
	set optionProperties = CreateObject()
	optionProperties.type = "action"
	optionProperties.value = "not started"
	optionProperties.caption = "blue not started icon"

 	jsonProperties = JsonSerialize(optionProperties)
	ActionButtons1.Categories.New.Style.Color = jsonProperties
	
	optionProperties.type = "action"
	optionProperties.value = "started"
	optionProperties.caption = "yellow started icon"
	
	for counter = 1 to 10
		jsonProperties = JsonSerialize(optionProperties)
		ActionButtons_Instructions.Style.Color = jsonProperties
		ActionButtons1.Categories.Actions_PartialList.Categories[MakeString("partial" , counter)].Style.Color = jsonProperties
	next 

	optionProperties.type = "action"
	optionProperties.value = "finished"
	optionProperties.caption = "green finished icon"
	
	for counter = 1 to 10
		jsonProperties = JsonSerialize(optionProperties)
		ActionButtons_Instructions.Style.Color = jsonProperties
		ActionButtons1.Categories.Actions_CompleteList.Categories[MakeString("complete", counter)].Style.Color = jsonProperties
	next 
	
	set customProperties = CreateObject()
	customProperties.separator = false 

 	jsonProperties = JsonSerialize(customProperties)
	ActionButtons_Instructions.Style.Color = jsonProperties
	ActionButtons_Hide.Style.Color = jsonProperties

	set customProperties.onesize = CreateObject()
	customProperties.onesize.state = true
	
	set customProperties.balance = CreateObject()
	customProperties.balance.state = true
	
	customProperties.submit = true
	
	set customProperties.sublistline = CreateObject()
	with customProperties.sublistline
		.state = true
		.length = "40"
	end with
	jsonProperties = JsonSerialize(customProperties)
	ActionButtons1.Style.Color = jsonProperties
	
	set actionsBanner = ActionButtons1.Banners.AddNew("Instruction", "")
	Do
		actionsBanner.text = MakeString("Completed ", ActionsCompleted.response, " of 40 patient forms this month")	
		ActionButtons1.Categories.Filter = ActionButtons_Shadow.response
		ActionButtons1.Response = null
		
'		JsonDeserialize(ActionButtons1.Categories.New.Style.Color, customProperties)
'		customProperties.value = Ctext(ActionsStart.response)
'		jsonProperties = JsonSerialize(customProperties)
'		ActionButtons1.Categories.New.Style.Color = jsonProperties
	
'	PageToAsk.layouttemplate = "XML.htm"
		PageToAsk.ask()
	
		if ActionButtons1.response.containsAny({new}) then
			ActionsStarted.response = ActionsStarted.response + 1
			ActionsStarted.response = MinOf(ActionsStarted.response, 10)
			ActionButtons_Shadow.response = ActionButtons_Shadow.response + CCategorical(MakeString("partial", ActionsStarted.Response))
		else
			if ActionButtons1.Response.format("a").Left(7) = "partial" then
				ActionButtons_Shadow.response = ActionButtons_Shadow.response - ActionButtons1.Response 
				ActionButtons_Shadow.response = ActionButtons_Shadow.response + CCategorical(MakeString("complete", Mid(ActionButtons1.Response.format("a"),7)))
				
				ActionsStarted.response = ActionsStarted.response + 1
				ActionsStarted.response = MaxOf(ActionsStarted.response, 0)
				
				ActionsCompleted.response = ActionsCompleted.response + 1
				ActionsCompleted.response = MinOf(ActionsCompleted.response, 10)
			end if
		end if 
				
	loop while ActionButtons_Exit.response = false
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if 

end section

