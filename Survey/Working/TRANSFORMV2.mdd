Section TabStripFunctions

'------------------------
' Tabstrip Functions
'========================

function SetPageToAsk(theIOM, theCurrentPage, theTabQuestion, theFilterQuestion)
dim whichTab, custom
dim tabDisableQuestion, numberOfTabs
dim counter, currentTab, currentTabIndex, DisableTabsFrom, currentFactor
dim filterArray
dim counterItem, counterFactor
	set setPageToAsk = FindPage(theIOM, theCurrentPage)
	whichTab = setPageToAsk.Properties.Item["CurrentTab"]

FilterTabs:
	filterArray = CCategorical(theFilterQuestion.Categories[WhichTab].label.text)
	theTabQuestion.categories.Filter = filterArray
	
	theTabQuestion.response = CCategorical(whichTab)
	currentFactor = theTabQuestion.response.Factor() 
	
	numberOfTabs = theTabQuestion.Categories.count

'enabled disable tabs	
	set tabDisableQuestion = theIOM.Questions["StripDisableTabs"]
	select case tabDisableQuestion.response 
	case {NoTabs}
		DisableTabsfrom = 9999
	case {AfterCurrent}
		DisableTabsFrom = currentFactor + 0.1
	case {OneAfterCurrent}
		DisableTabsFrom = currentFactor + 0.2
	end select
	
	for counter = 0 to numberOfTabs - 1
		set counterItem = theTabQuestion.Categories[counter]
		set counterFactor = counterItem.Factor
	
		if counterFactor &lt; DisableTabsFrom then
			counterItem.Style.Control.ReadOnly = false
		else
			counterItem.Style.Control.ReadOnly = true
		end if
	Next
end function

function FindPage(theIOM, theCurrentPage)
	on error Goto NotAPage
debug.Log(Makestring("Finding Page: ", theCurrentPage))
		set FindPage = theIOM.Pages[theCurrentPage]
		exit function
NotAPage:
debug.Log(Makestring("Finding Question: ", theCurrentPage))
		set FindPage = theIOM.Questions[theCurrentPage]
		exit function
end function

function CheckChangeofTab(theCurrentTab, theTabsQuestion, theTabsToPageQuestion)
dim newTab, numberOfPages, currentTab, counter

	theCurrentTab = theCurrentTab.LCase()
	newTab = format(ccategorical(theTabsQuestion.response.value),"a")
	
	debug.Log(MakeString("CheckChangeofTab [Current]" + theCurrentTab, ", [Destination]", newTab))
'	CheckChangeOfTab = ""
	if newTab &lt;&gt; theCurrentTab then
debug.Log("changing tab")
		checkChangeOfTab = theTabsToPageQuestion.Categories[theTabsQuestion.response].label.text
	else
debug.Log("NOT changing tab")
		checkChangeOfTab = ""
	end if
end function

end Section

Section GeneralFunctions
'------------------------
' General Functions
'========================

function SetupQuestion(theQuestion, theParentFullName, theHidden, theIOM)
dim currentName, currentFullname, currentType, currentOrder
dim registerBanner
dim numberOfSubQuestions, counter, subQuestion, subName
dim InstructionBanner, warningBanner
dim iterationCount, iterationCounter, currentIteration
dim questionName, iterationName
dim currentAdjustedName, currentTableName, currentAdjustedTableName
dim currentLoopName, currentAdjustedLoopName

dim currentAdjustedParentName, currentParentFullname, loopCounter, subLoop, loopQuestionCount 
dim iterationIndex
dim currentQuestionType, currentQuestionName
	
	currentName = theQuestion.QuestionName 
	currentAdjustedName = MakeString("_Q", currentName.Replace("_", "__"))
	currentFullname = theParentFullName + currentAdjustedName 
	currenttype = theQuestion.QuestionType
	
'debug.Log(MakeString("name: ", currentName, ", fullname: ", currentFullname, ", type: ", currentType))
	select case(thequestion.QuestionType)
	case QuestionTypes.qtBlock, QuestionTypes.qtPage
		if theQuestion.QuestionType = QuestionTypes.qtPage then
			CheckDefaultTemplate(theIOM, theQuestion, "page")
		else
			CheckDefaultTemplate(theIOM, theQuestion, "block")
		end if 
		numberOfSubQuestions = theQuestion.count 
		for counter = 0 to numberOfSubQuestions - 1
			set subQuestion = theQuestion[counter]
			SetupQuestion(subQuestion, currentFullName, false, theIOM)
			
		Next
		
	case QuestionTypes.qtLoopCategorical
		currentQuestionType = ApplyDefaultQuestionType(theQuestion,false)
		currentQuestionName = ApplyQuestionName(theQuestion, currentFullName)
		
		currentTableName = theQuestion.QuestionName  
		currentAdjustedTableName = MakeString("_Q", currentTableName.Replace("_", "__"))		
		iterationCount = theQuestion.Categories.Count
		
		for counter = 0 to iterationCount - 1
			set subLoop = theQuestion[counter]					
			loopQuestionCount = subLoop.count
			currentLoopName = theQuestion.Categories[counter].name  
			currentAdjustedLoopName = MakeString("_Q", currentLoopName.Replace("_", "__"))
			currentParentFullname = theParentFullName + currentAdjustedTableName + currentAdjustedLoopName
			for loopCounter = 0 to loopQuestionCount - 1
				set subQuestion = subloop[loopCounter]
				SetupQuestion(subQuestion, currentParentFullName, (currentQuestionType.Find("hidden")&gt;0), theIOM)	
			Next
		Next	
	case QuestionTypes.qtLoopNumeric
		currentQuestionType = ApplyDefaultQuestionType(theQuestion, false)
		currentQuestionName = ApplyQuestionName(theQuestion, currentFullName)

		currentTableName = theQuestion.QuestionName  
		currentAdjustedTableName = MakeString("_Q", currentTableName.Replace("_", "__"))	
		
		iterationCount = theQuestion.Count
		for each subLoop in theQuestion
			loopQuestionCount = subLoop.count
			currentLoopName = subLoop.QuestionName  
			currentAdjustedLoopName = MakeString("_Q", currentLoopName.Replace("_", "__"))
			currentParentFullname = theParentFullName + currentAdjustedTableName + currentAdjustedLoopName
			for loopCounter = 0 to loopQuestionCount - 1
				set subQuestion = subloop[loopCounter]
				SetupQuestion(subQuestion, currentParentFullName, (currentQuestionType.Find("hidden")&gt;0), theIOM)	
			Next
		next
		
	case else 
		if theQuestion.style.control.type = controltypes.ctEdit then theQuestion.style.control.type = controltypes.ctSingleLineEdit
		LookUpZIndex(theQuestion)
		ApplyDefaultQuestionType(theQuestion, theHidden)
		ApplyQuestionName(theQuestion, currentFullName)
	end select
	
dim qCurrentTab, qPageProperties, quote
	quote = chrW(34)
	set qCurrentTab = theIOM.Questions["CurrentTab"]
	set qPageProperties = theIOM.Questions["PageProperties"]
	ChangePageProperties(theIOM, qPageProperties, MakeString("tab=", quote, qcurrentTab.response, quote), true)

end function

function CheckDefaultTemplate(theIOM, theQuestion, theType)
dim defaults
'	set defaults = theIOM.Questions["defaulttemplates"]
'	If theQuestion.QuestionTemplate.Len() &lt; 1 then
'		select case theType
'		case "page"
'			theIOM.QuestionTemplate = defaults.Categories["defaultpage"].label.text
'		case "block"
'			theQuestion.QuestionTemplate = defaults.Categories["defaultblock"].label.text
'		end select
'	else
'		if theType = "page" then
'			theIOM.QuestionTemplate = theQuestion.QuestionTemplate	
'		end if
'	end if

end function

function ApplyQuestionName(theQuestion, theQuestionName)
dim currentBgColor
dim findColon
dim noQuestionName
dim currentName, currentType
dim newBgColor
	newBgColor = ""
	currentBgColor = theQuestion.style.bgcolor
	findColon = currentBgColor.Find(":")
	noQuestionName = false
	if findColon &lt; 0 then 
		noQuestionName = true
	else
		currentName = currentBgColor.Mid(findColon)
		currentType = currentBgColor.Left(findColon)
		if currentName.Len() &lt; 1 then
			noQuestionName = true
		else
			if currentName &lt;&gt; theQuestionName then
				noQuestionName = true
				currentName = ""
			end if
		end if
	end if
	
	if noQuestionName then 
		theQuestion.style.bgcolor = MakeString(currentType, ":", theQuestionName)
	end if
	ApplyQuestionname = theQuestionName
end function

function ApplyDefaultQuestionType(theQuestion, theHidden)
dim currentBgColor
dim findColon
dim noQuestionType
dim currentType, currentName, newType
dim newBgColor
	newBgColor = ""
	currentBgColor = theQuestion.style.bgcolor
	findColon = currentBgColor.Find(":")
	noQuestionType = false
	if findColon &lt; 0 then 
		noQuestionType = true
		currentType = ""
	else
		currentType = currentBgColor.left(findColon)
		currentName = currentBgColor.Mid(findColon)
		if currentType.Len() &lt; 1 then
			noQuestionType = true
		end if
	end if
	
	if noQuestionType then
		
		select case (theQuestion.QuestionDatatype)
			case DataTypeConstants.mtBoolean
				newType = ""
			case DataTypeConstants.mtCategorical
				newType = "choice"
			case DataTypeConstants.mtDate
				newType = "singleline-date"
			case DataTypeConstants.mtDouble
				newType = "singleline-number"
			case DataTypeConstants.mtLong
				newtype = "singleline-number"
			case DataTypeConstants.mtText
				if theQuestion.style.control.type.LCase() = "multilineedit" then
					newType = "multilineedit"
				else
					newType = "singleline"
				end if
			case else
				select case (theQuestion.questiontype)
					case QuestionTypes.qtLoopCategorical
						newtype = "loop"
					case QuestionTypes.qtLoopNumeric
						newtype = "loop"
				end select
		end select
		if theHidden then
			newType = newType + "-hidden"
			theQuestion.style.bgcolor = makeString(newType, ":", currentName)
		else
			theQuestion.style.bgcolor = makeString(newType, ":", currentName)
		end if
	else
		if theHidden then
			if currentType.Find("hidden") &lt; 0 then
				newType = currentType + "-hidden"
				theQuestion.style.bgcolor = makeString(newType, ":", currentName)
			else
				newType = currentType
			end if
		else 
			newType = currentType
		end if
	end if
	ApplyDefaultQuestionType = newType
end function

function LookUpZIndex(theQuestion)
dim currentZIndex, findColon
	currentZIndex = theQuestion.style.zIndex 
	if currentZIndex = "" then 
'		debug.Log(MakeString("WARNING No Zindex applied: ", theQuestion.QuestionFullName))
		exit function
	end if
	
	if theQuestion.style.BgColor &lt;&gt; "" then 
		findColon = theQuestion.style.BgColor.Find(":")
		if findColon &gt; 0 then exit function
	end if

    '----------------- Question Type zIndex values
    ' -10 Information
    ' -20 SingleLineEdit
    ' -21 ReadWriteEdit 
    ' -22 Decimal
    ' -30 MultiLineEdit
    ' -40 Choice
    ' -50 Slider (Horizontal)
    ' -51 Slider (Vertical)
    ' -55 Scale (Horizontal)
    ' -56 Scale (Vertical)
    ' -60 DropDown
    ' -70 Combobox
    ' -1100 Progressive (V) Grid
    ' -1110 Progressive (H) Grid
    ' -1400 Navigation - Tabstrip
    '---------------------------------------------
    
	select case currentZIndex
	case "-10"
		theQuestion.style.BgColor = "Information:"
	case "-20"
		theQuestion.style.BgColor = "singleline:"
	case "-30"
		theQuestion.style.BgColor = "multiline:"
	case "-40"
		theQuestion.style.BgColor = "choice:"
	case "-50"
		theQuestion.style.BgColor = "slider-horizonatal:"
	case "-55"
		theQuestion.style.BgColor = "scale-horizontal:"
	case "-60"
		theQuestion.style.BgColor = "combobox:"
	case "-70"
		theQuestion.style.BgColor = "dropdown:"
	end select
end function

function SetCustomProperties(theQuestion, thePropertyString)
dim verifyTest
dim jsonString
dim quote
	quote = ChrW(34)
	jsonString = thePropertyString.Replace("'", quote)
	jsonString = jsonString.Replace("\'", "'")
	
	theQuestion.style.Color = jsonString
	
	on error goto failedJson
	verifyTest = jsonDeSerialize(jsonString)
	debug.Log(theQuestion.QuestionName + "- json serialised: " + jsonSerialize(verifyTest))
	exit function

	failedJson:
	debug.Log(theQuestion.QuestionName + "- json not valid: " + thePropertyString)	
end function

function UpdatePageProperties(theIOM, thePagePropertiesQuestion)
dim stringProperties, stringHTML
dim bannerProperties
	set bannerProperties = theIOM.Banners["PageProperties"]
	stringProperties = thePagePropertiesQuestion.response
	stringHTML = MakeString("&lt;a-properties data-properties='", stringProperties, "'&gt;&lt;!-- Page Properties --&gt;&lt;/a-properties&gt;" )

	bannerProperties.text = stringHTML
end function

function ChangePageProperties(theIOM, thePageProperties, theChange, theUpdate)
dim jsonProperties
dim executeString
	if theUpdate is null then theUpdate = false
	
	set jsonProperties = jsonDeserialize(thePageProperties.response)
	executeString = MakeString("jsonProperties.", theChange)
	Execute (executeString)
	
	thePageProperties.response = jsonSerialize(jsonProperties)
	if theUpdate then UpdatePageProperties(theIOM, thePageProperties)
end function

function AddBanner(theQuestion, theBanner, theContent)
dim counter, numberOfBanners, currentBanner
dim targetLocation
	if theQuestion.questiontype = questiontypes.qtPage then
		set targetLocation = theQuestion[0]
	else
		set targetLocation = theQuestion
	end if
	
	debug.Log(Makestring("questiontype:" , targetLocation.questionname))

	numberofBanners = theQuestion.Banners.count
	currentBanner = null
	if numberOfBanners &gt; 0 then
		for counter = 0 to numberOfBanners - 1
			set currentBanner = targetLocation.Banners[counter]
			if currentBanner.Name = theBanner then Exit for
		next
	end if
	
	if currentBanner is null then
		currentBanner = targetLocation.Banners.AddNew(theBanner, theContent)
	else
		currentBanner.text = theContent
	end if
end function

sub CreateInformationPopup (theQuestion, theTitle, theContent)
dim informationBanner
dim bannerArray[8]
	CreateBanner(theQuestion, "Information")
	set informationBanner  = theQuestion.Banners["Information"]
	bannerArray[0] = "&lt;details class='o-message-information'&gt;"
	bannerArray[1] = "&lt;summary class='a-label-summary'&gt;"
	bannerArray[2] = theTitle
	bannerArray[3] = "&lt;/summary&gt;"
	bannerArray[4] = "&lt;div class='a-label-details'&gt;"
	bannerArray[5] = theContent
	bannerArray[6] = "&lt;/div&gt;"
	bannerArray[7] = "&lt;/details&gt;"
	
	
	informationBanner.text = CombineArray(bannerArray, "")
	
end sub

function CreateBanner(theQuestion, theBannerName)
dim bannerFound
	set bannerFound = FindBanner(theQuestion, theBannerName)
	if bannerFound is null then
		theQuestion.Banners.AddNew(theBannerName, "")
	end if
end function

function FindBanner(theQuestion, theBannerName)
dim numberOfBanners
dim bannerFound
dim bannercount
	numberOfBanners = theQuestion.Banners.count
	bannerFound = false
	for bannerCount = 0 to numberOfBanners - 1
		if theQuestion.Banners[bannerCount].name = theBannerName then
			set FindBanner = theQuestion.Banners[bannerCount]
			exit function
		end if
	Next
	set FindBanner = null
end function

function CombineArray(theArray, theBetween)
dim limit
dim counter 
dim newString
	newString = ""
	limit = ubound(theArray)
	for counter = 0 to limit
		newString = newString + theArray[counter]
		newString = newString + theBetween
	Next
	CombineArray = newString
end function

function CreateVisibilityRule(theRule)
dim newString 
'	newString = theRule.replace("'", "&amp;apos;").replace("_","__")
	newString = theRule.replace("_","__")
	newString = newString.Replace("__Q","_Q")
	CreateVisibilityRule = newString
end function

function CreateTranslationTable(theQuestion)
dim jsonTranslate, jsonTranslation
dim arrayTranslations[1]
dim currentCategory, arrayCounter

	set jsonTranslate = CreateObject()
	set jsonTranslation = CreateObject()
	
	redim (arrayTranslations, theQuestion.Categories.count, false)
	arrayCounter = 0
	
	for each currentCategory in theQuestion.Categories
		jsonTranslation.name = currentCategory.name.Replace("_", "-") 
		jsonTranslation.label = currentCategory.label 
		arrayTranslations[arrayCounter] = jsonTranslation
		arrayCounter = arrayCounter + 1
	Next
	jsonTranslate.translations = arrayTranslations 
	CreateTranslationTable = jsonSerialize(jsonTranslate)
end function

end section



