ty name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></styles></category><category id="_6343eef2-f456-45eb-b9e9-2ee5e7410cdb" name="complete9"><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">Patient form 9</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Patient form 9</text></labels><versions><version name="105"><category name="complete9"/></version></versions><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></DIFF></versions><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></styles></category><category id="_df1c45f2-c1be-463c-aeae-877b023ae748" name="complete10"><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">Patient form 10</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Patient form 10</text></labels><versions><version name="105"><category name="complete10"/></version></versions><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></DIFF></versions><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></styles></category></categories><variable id="31cf2fb7-0533-41e3-85b4-261813f3fdd7" name="ActionButtons_Instructions" type="0"><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US"></text></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;style&gt;.iconouter{display:inline-block;vertical-align:middle;margin-right:4px;} .iconinner{padding:4px} .status-box{display: inline-block; border:2px solid;border-radius:2pt;margin:4px;padding-right:8px;}&lt;/style&gt;&lt;p&gt;From this Main Menu you can access the sections which need to be completed by clicking on the appropriate buttons. Please use the link's BACK and FORWARD buttons rather than those on your internet browser. Button colours will denote your current participation status:&lt;/p&gt;&lt;div class='status-box' style='border-color:#2F469C'&gt;&lt;div class='iconouter' style='background-color:#2F469C;'&gt;&lt;img alt='blue not started icon' class='iconinner' src='https://cdn.ipsosinteractive.com/sandbox/kevin.gray/transform/v2/staging/static/images/notstarted.svg' height='32px' width='32px' /&gt;&lt;/div&gt;&lt;span style='color:#2F469C;'&gt;Blue&lt;/span&gt;&lt;span class='a-label-option'&gt; buttons denote sections to be completed.&lt;/span&gt;&lt;/div&gt;
    &lt;div class='status-box' style='border-color:#8F6400'&gt;&lt;div class='iconouter' style='background-color:#8F6400;'&gt;&lt;img alt='Yellow in progress icon' class='iconinner' src='https://cdn.ipsosinteractive.com/sandbox/kevin.gray/transform/v2/staging/static/images/started.svg' height='32px' width='32px' /&gt;&lt;/div&gt;&lt;span style='color:#8F6400;'&gt;Yellow&lt;/span&gt;&lt;span class='a-label-option'&gt; buttons denote partially completed sections&lt;/span&gt;&lt;/div&gt;
    &lt;div class='status-box' style='border-color:#007675'&gt;&lt;div class='iconouter' style='background-color:#007675;'&gt;&lt;img alt='Green completed icon' class='iconinner' src='https://cdn.ipsosinteractive.com/sandbox/kevin.gray/transform/v2/staging/static/images/finished.svg' height='32px' width='32px' /&gt;&lt;/div&gt;&lt;span style='color:#007675;'&gt;Green&lt;/span&gt;&lt;span class='a-label-option'&gt; buttons denote completed sections&lt;/span&gt;&lt;/div&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;style&gt;.iconouter{display:inline-block;vertical-align:middle;margin-right:4px;} .iconinner{padding:4px} .status-box{display: inline-block; border:2px solid;border-radius:2pt;margin:4px;padding-right:8px;}&lt;/style&gt;&lt;p&gt;From this Main Menu you can access the sections which need to be completed by clicking on the appropriate buttons. Please use the link's BACK and FORWARD buttons rather than those on your internet browser. Button colours will denote your current participation status:&lt;/p&gt;&lt;div class='status-box' style='border-color:#2F469C'&gt;&lt;div class='iconouter' style='background-color:#2F469C;'&gt;&lt;img alt='blue not started icon' class='iconinner' src='https://cdn.ipsosinteractive.com/sandbox/kevin.gray/transform/v2/staging/static/images/notstarted.svg' height='32px' width='32px' /&gt;&lt;/div&gt;&lt;span style='color:#2F469C;'&gt;Blue&lt;/span&gt;&lt;span class='a-label-option'&gt; buttons denote sections to be completed.&lt;/span&gt;&lt;/div&gt;
    &lt;div class='status-box' style='border-color:#8F6400'&gt;&lt;div class='iconouter' style='background-color:#8F6400;'&gt;&lt;img alt='Yellow in progress icon' class='iconinner' src='https://cdn.ipsosinteractive.com/sandbox/kevin.gray/transform/v2/staging/static/images/started.svg' height='32px' width='32px' /&gt;&lt;/div&gt;&lt;span style='color:#8F6400;'&gt;Yellow&lt;/span&gt;&lt;span class='a-label-option'&gt; buttons denote partially completed sections&lt;/span&gt;&lt;/div&gt;
    &lt;div class='status-box' style='border-color:#007675'&gt;&lt;div class='iconouter' style='background-color:#007675;'&gt;&lt;img alt='Green completed icon' class='iconinner' src='https://cdn.ipsosinteractive.com/sandbox/kevin.gray/transform/v2/staging/static/images/finished.svg' height='32px' width='32px' /&gt;&lt;/div&gt;&lt;span style='color:#007675;'&gt;Green&lt;/span&gt;&lt;span class='a-label-option'&gt; buttons denote completed sections&lt;/span&gt;&lt;/div&gt;</text></labels><versions><version name="105"><variable name="ActionButtons_Instructions" type="0"/></version></versions><templates><versions><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question.htm" type="8" context="Question"/></templates></variable><variable id="7b48413d-b3ee-4555-8126-a54251ddf4c4" name="ActionButtons_Hide" type="7"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="BgColor" value="bool:" type="8" context="Question"/></DIFF></versions><property name="BgColor" value="bool:" type="8" context="Question"/></styles><templates><versions><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="boolean.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="boolean.htm" type="8" context="Question"/></templates><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">Hide Completed forms</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Hide Completed forms</text></labels><versions><version name="105"><variable name="ActionButtons_Hide" type="7"/></version></versions></variable><page id="1073771907" name="ActionButtons_Page1" global-name-space="0"><properties><versions><DIFF OP="ADD" name=