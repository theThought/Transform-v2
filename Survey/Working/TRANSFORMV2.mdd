		newProps.name = FruitSelection.Categories[counter].Name
		newProps.rules = CreateVisibilityRule(MakeString("FruitSelection.containsNone('", FruitSelection.Categories[counter].Name, "')"))
		if propsOptions is null then
			propsOptions = jsonSerialize(newProps)
		else
			propsOptions = MakeString(propsOptions, ",", jsonSerialize(newProps))
		end if
	next

	set customProperties.options.invisible = jsonDeSerialize(MakeString("[", propsOptions, "]"))
		
	jsonProperties = JsonSerialize(customProperties)
	FruitFirst.Style.Color = jsonProperties
	
