section cbPaperDay
	PageToDisplay.response = "cbPaperDay"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	set customProperties = CreateObject()
	with customProperties
		.listsize = 5
		.filtertype = "contains"
		.noitemsinlist = "nothing left"
	end with
	
	for iterationLoop = 0 to cbPaperDay.Count -1 
		set iterationItem = cbPaperDay[iterationLoop]
		
		if iterationLoop &gt; 4 then iterationItem["WhichPaper"].Style.Control.ReadOnly = true
