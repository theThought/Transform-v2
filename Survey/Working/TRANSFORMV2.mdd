section Visibility

section SmokePage
	PageToDisplay.response = "SmokePage"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

dim visibilityProperties
'New rules structure for visibility
	Howmany_smoked.MustAnswer = false
	WeekendPercentage.MustAnswer = false


	currentRule = CreateVisibilityRule("Doyou_smoke.containsAny('Yes_Smoked')")
	set customProperties = CreateObject()
	customProperties.separator = true
	
	customProperties.jumptofirstletter = true
	set visibilityProperties = CreateObject()
	visibilityProperties.collapse = true
	visibilityProperties.rules = currentRule
	set customProperties.visible = visibilityProperties

	jsonProperties = JsonSerialize(customProperties)
	smoke_cigars.Style.Color = jsonProperties

	currentRule = CreateVisibilityRule("(!smoke_cigars.containsAny('cigarettes')) AND (smoke_cigars.answerCount() &gt; 0)")	
	visibilityProperties.rules = currentRule
	set customProperties.visible = visibilityProperties

	jsonProperties = JsonSerialize(customProperties)
	brandswhich.Style.Color = jsonProperties

	currentRule = CreateVisibilityRule("smoke_cigars.containsAny('cigarettes')")
	visibilityProperties.rules = currentRule
	set customProperties.visible = visibilityProperties

	jsonProperties = JsonSerialize(customProperties)
	Howmany_smoked.Style.Color = jsonProperties
	
	currentRule = CreateVisibilityRule("Doyou_smoke.containsAny('Yes_vaped')")
	visibilityProperties.rules = currentRule
	set customProperties.visible = visibilityProperties

	jsonProperties = JsonSerialize(customProperties)
	Howmanyvaped.Style.Color = jsonProperties

	currentRule = CreateVisibilityRule("Howmany_smoked &gt;= 30")
	set customProperties = CreateObject()
	visibilityProperties.rules = currentRule
	set customProperties.visible = visibilityProperties

	set customProperties.show = CreateObject()
	customProperties.show.value = true
	customProperties.show.terminators = true
	customProperties.ticklabels = 10
	customProperties.floodtovalue = true
	
	jsonProperties = JsonSerialize(customProperties)
	Weekendpercentage.Style.Color = jsonProperties

	currentRule = "Weekendpercentage.isVisible()"
	set customProperties = CreateObject()
	visibilityProperties.rules = currentRule
	set customProperties.visible = visibilityProperties

	jsonProperties = JsonSerialize(customProperties)
	WeekendIncrease.Style.Color = jsonProperties

	currentRule = CreateVisibilityRule("Doyou_smoke.containsAny('Yes_Smoked') and smoke_cigars.containsAny('cigarettes') and Howmany_smoked &lt;= 0")
'	currentRule = "Weekendpercentage.isVisible()"
	set customProperties = CreateObject()
	visibilityProperties.rules = currentRule
	set customProperties.visible = visibilityProperties

	jsonProperties = JsonSerialize(customProperties)
	PleaseReview.Style.Color = jsonProperties

	currentRule = CreateVisibilityRule("Doyou_smoke.containsAny('Yes_smoked','yes_vaped') or Doyou_smoke.answerCount()&lt;1")
	'currentRule = "Weekendpercentage.isVisible()"
	set customProperties = CreateObject()
	visibilityProperties.rules = currentRule
	set customProperties.invisible = visibilityProperties

	jsonProperties = JsonSerialize(customProperties)
	DidyouPreviously.Style.Color = jsonProperties

	currentRule = CreateVisibilityRule("Doyou_smoke.answerCount()&lt;1")
	set customProperties = CreateObject()
	set customProperties.visible = CreateObject()
	customProperties.visible.rules = currentRule
	customProperties.visible.collapse = true
	
	jsonProperties = JsonSerialize(customProperties)
	DoYouMind.Style.Color = jsonProperties
	
	
'	PageToAsk.layouttemplate = "xml.htm"
	PageToAsk.Ask()

	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if 
end section

