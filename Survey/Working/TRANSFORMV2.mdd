		.visible.collapse = true
		.visible.rules = CreateVisibilityRule("DynamicLabelChoice.containsAny('choice3')")
	end with
	
	set customProperties = CreateObject()
	set customProperties.labels = CreateObject()
	set customProperties.labels.alternatives = MakeArray(labelRule[0], labelRule[1], labelRule[2])
	set customProperties.labels.separator = ""
	
