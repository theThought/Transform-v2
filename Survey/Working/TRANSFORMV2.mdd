iA9ICIiCgoTRNcwE4VUg35TiWuGIWO0UIojM4KRHbRxQ4H9I4KrNQF0Jy0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLQonIHJlc2V0IHRvIG51bGwvbG9hZAonPT09PT09PT09PT09PT09PT09PT09PT09CgpzZWN0aW9uIHZpc2libGVyZXNldApzZWN0aW9uIHZpc2libGVyZXNldDFTIpwUY/RlgeEX</script-delta></DIFF><DIFF OP="DEL" name="100" Index="1"/><DIFF OP="ADD" name="100" Index="1"><script-delta name="main" default="-1" delta="-1">1sPEUwABheZ4AIFDhcwdAACBOwBzgnoAARUKdGV4dERpcmVjdGlvbiA9ICIiCgoTRNcwE4VUg35TiWuGIWO0UIojM4KRHbRxQ4H9I4KrNQF0Jy0tLS0tLS0tLS0tLS0tLS0tLS0tLS0tLQonIHJlc2V0IHRvIG51bGwvbG9hZAonPT09PT09PT09PT09PT09PT09PT09PT09CgpzZWN0aW9uIHZpc2libGVyZXNldApzZWN0aW9uIHZpc2libGVyZXNldDFTIpwUY/RlgeEX</script-delta></DIFF><DIFF OP="DEL" name="101" Index="0"/><DIFF OP="ADD" name="101" Index="0"><script-delta name="source" delta="-1">1sPEUwABheZ4AAyF5ngAAAUAc4XmeAA=</script-delta></DIFF><DIFF OP="DEL" name="101" Index="1"/><DIFF OP="ADD" name="101" Index="1"><script-delta name="main" default="-1" delta="-1">1sPEUwABheZ4AAyF5ngAAAUAc4XmeAA=</script-delta></DIFF><DIFF OP="DEL" name="102" Index="0"/><DIFF OP="ADD" name="102" Index="0"><script-delta name="source" delta="-1">1sPEUwABhelNAE+F5ngAAEgAc4lyAAV0cnVlE4IkigFDiGmCRgEaJ2dvdG8gUGFnZUdyaWRvdGhlcnNwZWNpZnlTwV6IfWOElmHCGWMhlFwzXYNDU/gehJYP</script-delta></DIFF><DIFF OP="DEL" name="102" Index="1"/><DIFF OP="ADD" name="102" Index="1"><script-delta name="main" default="-1" delta="-1">1sPEUwABhelNAE+F5ngAAEgAc4lyAAV0cnVlE4IkigFDiGmCRgEaJ2dvdG8gUGFnZUdyaWRvdGhlcnNwZWNpZnlTwV6IfWOElmHCGWMhlFwzXYNDU/gehJYP</script-delta></DIFF><DIFF OP="DEL" name="103" Index="0"/><DIFF OP="ADD" name="103" Index="0"><script-delta name="source" delta="-1">1sPEUwABhespADqF6U0AADMAc5NEABOBbJNjDWdvdG8gSW1hZ2VJbkOC23SCL1OB9iuC3DtjI4O/SzNLlDFjgYEEgfdY</script-delta></DIFF><DIFF OP="DEL" name="103" Index="1"/><DIFF OP="ADD" name="103" Index="1"><script-delta name="main" default="-1" delta="-1">1sPEUwABhespADqF6U0AADMAc5NEABOBbJNjDWdvdG8gSW1hZ2VJbkOC23SCL1OB9iuC3DtjI4O/SzNLlDFjgYEEgfdY</script-delta></DIFF><DIFF OP="DEL" name="104" Index="0"/><DIFF OP="ADD" name="104" Index="0"><script name="source">"dim customProperties, jsonProperties
dim nextTab, tabStripPageProperties
dim counter
dim counterItem, counterPage, counterTab, counterJSON
dim pageToAsk
dim mockResponse
dim jumpToTab
dim iterationLoop, iterationItem, currentIteration, previousName, iterationName
Dim currentRule
dim jsonPageProperties, bannerPageProperties, questionPageProperties
dim quote
dim textDirection
dim boolResetToNull

textDirection = ""
boolResetToNull = true

IOM.LayoutTemplate = MakeString("TabbedPage", textDirection, ".htm") 
IOM.QuestionTemplate = "Question.htm"
IOM.MustAnswer = false

set bannerPageProperties = IOM.Banners.AddNew("PageProperties", "")
set questionPageProperties = IOM.Questions["PageProperties"]
bannerPageProperties.style.BgColor="pageproperties:"
quote = ChrW(34)


Section SetPageProperties
	if questionPageProperties.response = null then
		set jsonPageProperties = CreateObject()
		
		Settings_ShowSeparator.response.initial = true
		Settings_Focus.response.initial = {Question, Control}
		Settings_SideBySide.response.initial = 35
		Settings_AllowPaste.response.initial = false
		Settings_JumptoFirstError.response.initial = true
		Settings_Validation.response.initial = true
		Settings_Float.Response.Initial = {float}
		Settings_ResetToNull.response = boolResetToNull
		Settings_Direction.Response = {LTR}
		
		with jsonPageProperties
			.validate = true
			.floatdetails = false
			.separator = true
			.sidebyside = 35
			set .focus = CreateObject()
			.focus.question = true
			.focus.control = true
			.paste = false
			.jumptoerror = true
			.tab = ""
			.resettonull = boolResetToNull
		end with
	
		questionPageProperties.Response = jsonSerialize(jsonPageProperties)
		UpdatePageProperties(IOM, questionPageProperties)
	end if
end section

section SetupTabStrip
debug.log(Makestring("setuptabstrip: [PageToDisplay]" , PageToDisplay.Response, " [Tabs]", Tabs.response))
	if PageToDisplay.Response is null then
		NextPage = "StripInstructions"
		NextTab = "StripInstructions"
	else
		NextPage = PageToDisplay.Response
		NextTab = TabToPage.Categories(NextPage).label.text
	end if
	set customProperties = CreateObject()
	set customProperties.onesize = CreateObject()
	customProperties.onesize.state = false
	
	jsonProperties = JsonSerialize(customProperties)
	Tabs.Style.Color = jsonProperties
	if Tabs.Response is null then
		Tabs.Response = {StripInstructions}
	end if
	
	StripOneSize.Response = {sizetofit}
    StripDisableTabs = {NoTabs}

	ShowTabStrip.Response.Initial = {Yes}
'	ShowTabStrip.Response = {No}
	ShowTabStrip.Ask()
	If ShowTabStrip.Response.containsAny({Yes}) then 
	    IOM.GlobalQuestions.Add(Tabs)
	end if
	boolResetToNull = (Settings_ResetToNull.response = true)
end section

'To go straight to a specific question for testing

'FormSingleLineBlock.Ask()
'Form8SingleLinePage.Ask()

'goto Form1Question

Section JumpBackwards

debug.Log(MakeString("JumpBackwards: ", lcase(NextPage)))


	select case lcase(NextPage)
	case "stripinstructions"
		Goto StripInstructions
	case "openinstructions"
		Goto OpenInstructions
	case "closedinstructions"
		Goto ClosedInstructions
	case "horizontalinstructions"
		Goto HorizontalInstructions
	case "visibleinstructions"
		Goto VisibleInstructions
	case "iterationinstructions"
		Goto IterationInstructions
	case "pageconfiguration"
		Goto Settings
'	case "striplabels"
'		Goto ShowStripLabels
	case "singleline1"
		Goto singleline1
	case "choice1"
		Goto choice1
	case "slider1"
		Goto slider1
	case "scale1"
		Goto scale1
	case "list1"
		Goto List1
	case "dd_drugtest"
		Goto dd_pagedrugtest
	case "cb_drugtest"
		Goto cb_drugtest
	case "dd_newproducts"
		Goto dd_newproducts
	case "dd_newproductsna"
		Goto dd_newproductsNA
	case "smokepage"
		Goto smokepage
	case "iterationopenpage"
		Goto iterationopenpage
	case "moods"
		Goto Moods
	case "moodsoptional"
		Goto MoodsOptional
	case "childagesmonthyear"
		Goto ChildAgesMonthYear
	case "lstpaperday"
		Goto ListPaperDay
	case "LstPaperDayOptional"
		Goto ListPaperDayOptional
	case "olympians"
		Goto Olympians
	case "drinks"
		Goto Drinks
	case "eightopens"
		Goto EightOpens
	case "threedropdowns"
		Goto threedropdowns
	case "eighthiddenopens"
		Goto eighthiddenopens
	case "recentdrinks"
		Goto recentdrinks
	case "gridotherspecify"
		Goto gridotherspecify
	case "questionstructure"
		Goto questionstructure
	case "complextotals"
		Goto ComplexTotals
	case "totals_subheading"
		Goto totals2columnheadings
	case  "visiblefilters"
		Goto visiblefilters
    case "dynamiclabels"
    	Goto dynamiclabels
    case "painrelief"
    	Goto PainRelief
    case "visibleiterations"
    	Goto gridotherspecify
    case "visiblereset"
    	Goto visiblereset
    case "ddpaperday"
    	Goto ddPaperDay
    case "cbpaperday"
    	Goto cbPaperDay
    case "visiblegrids"
    	Goto visiblegrids
	case "papersbyday"
		goto papersbyDay
	case "iagree"
		goto IAgreeBoolean
	case "visibleoptions"
		goto VisibleOptions
	case "forminstructions"
		goto formInstructions
	case "form1question"
		goto Form1Question
	case "imageinstructions"
		goto ImageInstructions
	case "imageinquestion"
		goto ImageInQuestion
	case "imageincategorysingle"
        goto ImageInCategorySingle 
	case "imageincategorymulti"
		Goto ImageInCategoryMulti 
    case "figures"
    	Goto Figures 
	case "comicstrip"
		goto ComicStrip
	end select

end section


Section StripInstructions
	PageToDisplay.response = "StripInstructions"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

'IOM.LayoutTemplate = "xml.htm"
	IOM.Title = "Welcome to this Transform Demonstration"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

section enhancedinformation
 	PageToDisplay.response = "Hello"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
'IOM.LayoutTemplate = "xml.htm"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

section QuestionStructure
 	PageToDisplay.response = "QuestionStructure"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
	
	QuestionStructure.LayoutTemplate = MakeString("TabbedPage", textDirection, ".htm")
	
	if FindBanner(LayoutInformation, "Instruction") is null then
		LayoutInformation.Banners.AddNew("Instruction", "Provide an instruction here")
		AdultsandChildren.Banners.AddNew("Instruction", "Enter whole numbers")
		financiallydependent.Banners.AddNew("Instruction", "Provide an instruction here")
		sidebysidelayout.Banners.AddNew("Instruction", "Provide an instruction here")
		WhichQuestion.Banners.AddNew("Instruction", "Provide an instruction here")
		Howmany1.Banners.AddNew("Instruction", "Provide an instruction here")
		Howmany2.Banners.AddNew("Instruction", "Provide an instruction here")
	end if
	
	CreateInformationPopup(LayoutInformation, "Layout", "This example is trying to show how information can be positioned and to demonstrate the responsive effect on question structure")
	CreateInformationPopup(AdultsandChildren, "Age bands", "&lt;p&gt;The groups are defined as:&lt;ul&gt;&lt;li&gt;babies: 0 to 2 years&lt;/li&gt;&lt;li&gt;todlers: 2 to 5 years&lt;/li&gt;&lt;li&gt;juveniles: 5 to 12 years&lt;/li&gt;&lt;li&gt;teenagers: 13 to 19 years&lt;/li&gt;&lt;li&gt;Young adults: 20 to 35 years&lt;/li&gt;&lt;li&gt;adults: 35 - 65 years&lt;/li&gt;&lt;li&gt;over 65 years&lt;/li&gt;&lt;/ul&gt;&lt;/p&gt;")
	CreateInformationPopup(financiallydependent, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	CreateInformationPopup(sidebysidelayout, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	CreateInformationPopup(WhichQuestion, "Configuration", "&lt;p&gt;Various custom properties can be provided to adjust the configuration of a question.&lt;/p&gt;&lt;p&gt;each question can have its own information content&lt;/p&gt;")
	CreateInformationPopup(HowMany1, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	CreateInformationPopup(HowMany2, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	
	set customProperties = CreateObject()
	set customProperties.visible = CreateObject()
	set customProperties.labels = CreateObject()
	customProperties.labels.post = "visits"
	customProperties.visible.collapse = true
	currentRule = CreateVisibilityRule("WhichQuestion.containsAny('patient')")
	customProperties.visible.rules = currentRule
	jsonProperties = JsonSerialize(customProperties)
	Howmany1.Style.Color = jsonProperties
	

	currentRule = CreateVisibilityRule("WhichQuestion.containsAny('doctor')")
	customProperties.visible.rules = currentRule
	set customProperties.labels = CreateObject()
	customProperties.labels.post = "patients"
	jsonProperties = JsonSerialize(customProperties)
	Howmany2.Style.Color = jsonProperties
	
'IOM.LayoutTemplate = "xml.htm"
	IOM.Title = "Layout Test"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

section QuestionStructure_Forced
 	PageToDisplay.response = "QuestionStructure"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
	QuestionStructure.LayoutTemplate = MakeString("forcedlayout-page", textDirection, ".htm")
	
'	IOM.LayoutTemplate = "xml.htm"
	IOM.GlobalQuestions.Clear()
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

Section Settings
dim focusSettings
	PageToDisplay.response = "PageConfiguration"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
	IOM.Title = "Page Properties"
'	IOM.LayoutTemplate = "xml.htm"
	PageToAsk.ask()
	
	ChangePageProperties(IOM, questionPageProperties, MakeString("separator=", CText(Settings_ShowSeparator.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("floatdetails=", Settings_Float.containsAny("float")), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("validate=", CText(Settings_Validation.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("paste=", CText(Settings_AllowPaste.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("jumptoerror=", CText(Settings_ShowSeparator.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("sidebyside=", CText(Settings_SideBySide.response)), false)
	if Settings_Focus.Response.containsAny("question") then 
		ChangePageProperties(IOM, questionPageProperties, "focus.question=true", false)
	else
		ChangePageProperties(IOM, questionPageProperties, "focus.question=false", false)	
	end if
	if Settings_Focus.Response.containsAny("control") then 
		ChangePageProperties(IOM, questionPageProperties, "focus.control=true", false)
	else
		ChangePageProperties(IOM, questionPageProperties, "focus.control=false", false)	
	end if
	
	UpdatePageProperties(IOM, questionPageProperties)
	set customProperties = CreateObject()
	set customProperties.balance = CreateObject()
	customProperties.balance.state = true
	
	set customProperties.onesize = CreateObject()
	customProperties.onesize.state = StripOneSize.Response.containsAny("sizetofit")

	jsonProperties = JsonSerialize(customProperties)
	tabs.Style.Color = jsonProperties

	if Settings_Direction.response.ContainsAny("LTR") then 
		textDirection = ""
	else
		textDirection = "RTL"
	end if
	boolResettoNull = (Settings_Resettonull.Response = true)
	
	if ShowTabStrip.Response.containsAny("yes") then
		IOM.LayoutTemplate = MakeString("TabbedPage", textDirection, ".htm")
	else
		IOM.LayoutTemplate = MakeString("Page", textDirection, ".htm")
	end if
	
'	IOM.LayoutTemplate = "xml.htm"
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if

end section

Section VisibleInstructions
	PageToDisplay.response = "VisibleInstructions"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

Section IterationInstructions
	PageToDisplay.response = "IterationInstructions"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)


	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

Section OpenInstructions
	PageToDisplay.response = "OpenInstructions"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	IOM.Title = "SingleLine"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

section Singleline1
	PageToDisplay.response = "Singleline1"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)


	'singleline1.layouttemplate = "XML.htm"
	'---- singleline quesiton setup ----
	set customProperties = CreateObject()
	customProperties.step = 20
	jsonProperties = JsonSerialize(customProperties)
	HowLong.Style.Color = jsonProperties
	HowLong.MustAnswer = false
	'Howlong.Style.Control.ReadOnly = true
	
'	customProperties.step = 0.01
	jsonProperties = JsonSerialize(customProperties)
	CurrentPrice.Style.Color = jsonProperties

	set customProperties = CreateObject()
	customProperties.step = 10
	jsonProperties = JsonSerialize(customProperties)
	Twodecimal.Style.Color = jsonProperties
	
	set customProperties = CreateObject()
	set customProperties.labels = CreateObject()
	customProperties.labels.pre = "$"
	jsonProperties = JsonSerialize(customProperties)
	
	Paymentmade.Style.Color = jsonProperties
	cashback.Style.Color = jsonProperties
	
	set customProperties = CreateObject()
	customProperties.showspinner = false
	jsonProperties = JsonSerialize(customProperties)
	tipgiven.Style.Color = jsonProperties

'	IOM.LayoutTemplate = "xml.htm"	
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

Section Singleline2
	PageToDisplay.response = "Singleline2"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	'singleline2.layouttemplate = "XML.htm"
	
	justyesno.Response.initial = {Yes}
	methodsimple.Response.initial = {debit, store}
	
	set customProperties = CreateObject()
	customProperties.balance = CreateObject()
	customProperties.balance.state = true
	set customProperties.onesize = CreateObject()
	customProperties.onesize.state = true
	jsonProperties = JsonSerialize(customProperties)
	
	methodsimple.Style.Color = jsonProperties
	methodcomplexmulti.style.color = jsonProperties
	
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

Section ClosedInstructions
	PageToDisplay.response = "ClosedInstructions"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	IOM.Title = "Closed Questions"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section

Section Drinks
	PageToDisplay.response = "Drinks"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	IOM.Title = "Choice Questions"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if

end Section

section recentdrinks
	PageToDisplay.response = "recentdrinks"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
'	recentdrinks.layouttemplate = "XML.htm"	
'	recentdrinks.response.Initial = {FantaOrange}
