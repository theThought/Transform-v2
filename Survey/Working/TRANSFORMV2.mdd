		Howmany1.Banners.AddNew("Instruction", "Provide an instruction here")
		Howmany2.Banners.AddNew("Instruction", "Provide an instruction here")
	end if
	
	CreateInformationPopup(LayoutInformation, "Layout", "This example is trying to show how information can be positioned and to demonstrate the responsive effect on question structure")
	CreateInformationPopup(AdultsandChildren, "Age bands", "&lt;p&gt;The groups are defined as:&lt;ul&gt;&lt;li&gt;babies: 0 to 2 years&lt;/li&gt;&lt;li&gt;todlers: 2 to 5 years&lt;/li&gt;&lt;li&gt;juveniles: 5 to 12 years&lt;/li&gt;&lt;li&gt;teenagers: 13 to 19 years&lt;/li&gt;&lt;li&gt;Young adults: 20 to 35 years&lt;/li&gt;&lt;li&gt;adults: 35 - 65 years&lt;/li&gt;&lt;li&gt;over 65 years&lt;/li&gt;&lt;/ul&gt;&lt;/p&gt;")
	CreateInformationPopup(financiallydependent, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	CreateInformationPopup(sidebysidelayout, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	CreateInformationPopup(WhichQuestion, "Configuration", "&lt;p&gt;Various custom properties can be provided to adjust the configuration of a question.&lt;/p&gt;&lt;p&gt;each question can have its own information content&lt;/p&gt;")
	CreateInformationPopup(HowMany1, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	CreateInformationPopup(HowMany2, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	
	set customProperties = CreateObject()
	set customProperties.visible = CreateObject()
	set customProperties.labels = CreateObject()
	customProperties.labels.post = "visits"
	customProperties.visible.collapse = true
	currentRule = CreateVisibilityRule("WhichQuestion.containsAny('patient')")
	customProperties.visible.rules = currentRule
	jsonProperties = JsonSerialize(customProperties)
	Howmany1.Style.Color = jsonProperties
	

	currentRule = CreateVisibilityRule("WhichQuestion.containsAny('doctor')")
	customProperties.visible.rules = currentRule
	set customProperties.labels = CreateObject()
	customProperties.labels.post = "patients"
	jsonProperties = JsonSerialize(customProperties)
	Howmany2.Style.Color = jsonProperties
	
