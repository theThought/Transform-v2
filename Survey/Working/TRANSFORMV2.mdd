	set customProperties = CreateObject()
	with customProperties
		.filtertype = "starts"
		.listsize = 10
		.mincharactersforlist = 0
		.noitemsinlist = "no items match this filter"
	end with
	 
	jsonProperties = JsonSerialize(customProperties)
	for each currentIteration in visiblecombogrid
		currentIteration.comboboxquestion.style.color = jsonProperties
		currentIteration.comboboxquestiontwo.style.color = jsonProperties
	next 

	set customProperties = CreateObject()
	with customProperties
		.jumptofirstletter = true
		.listsize = 10
	end with
	 
	jsonProperties = JsonSerialize(customProperties)
	for each currentIteration in visibledropdowngrid
		currentIteration.droplistquestion.style.color = jsonProperties
		currentIteration.droplistquestiontwo.style.color = jsonProperties
	next 	

	set customProperties = CreateObject()
	with customProperties
		set .labels = CreateObject()
		.labels.pre = "a little"
		.labels.post = "a lot"
		set .show = CreateObject()
		.show.marks = true
		.show.value = true
		.show.terminators = true
		
		.ticklabels = true
		.floodtovalue = true
	end with
	 
	jsonProperties = JsonSerialize(customProperties)
	for each currentIteration in visibleslidergrid
		currentIteration.sliderquestion.style.color = jsonProperties
	next 	

	visiblechoicegrid[..].choicequestion.Categories[..].style.cell.width="10em"
	visibleslidergrid[..].sliderquestion.Style.align = alignments.alLeft

	set customProperties = CreateObject()
	with customProperties
		set .visible = CreateObject()
		.visible.collapse = true
		.visible.rules = CreateVisibilityRule("WhichGridVisible.containsAny('combo')")
	end with
	jsonProperties = JsonSerialize(customProperties)
	visiblecombogrid.style.color = jsonProperties
	
	customProperties.visible.rules = CreateVisibilityRule("WhichGridVisible.containsAny('dropdown')")
	jsonProperties = JsonSerialize(customProperties)
