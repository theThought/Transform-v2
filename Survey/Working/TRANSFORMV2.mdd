	for counter = 0 to fruitselection.Categories.Count -1
		set newProps = createObject()
		newProps.name = FruitSelection.Categories[counter].Name
		newProps.label =  FruitSelection.Categories[counter].Label
		newProps.block = false
		set newProps.visible = CreateObject()
		newProps.visible.collapse = true
		newProps.visible.rules = CreateVisibilityRule(MakeString("FruitSelection.containsAny('", FruitSelection.Categories[counter].Name, "')"))
		if propsAlternative is null then
			propsAlternative = jsonSerialize(newProps)
		else
			propsAlternative = MakeString(propsAlternative, ", ", jsonSerialize(newProps))
		end if
	next

	set customProperties.labels.alternatives = jsonDeSerialize(MakeString("[", propsAlternative, "]"))
	
	set customProperties.options = CreateObject()
	set customProperties.options.invisible = CreateObject()
	
	for counter = 0 to fruitselection.Categories.Count -1
