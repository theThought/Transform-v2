 section fruitfirst	
 dim propsAlternative
 dim propsOptions
 dim newProps
 
 	PageToDisplay.response = "FruitPage"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	set customProperties = CreateObject()
	customProperties.separator = true
	set customProperties.onesize = CreateObject()
	customProperties.onesize.state = true
	set customProperties.balance = CreateObject()
	customProperties.balance.state = true
	
	set customProperties.visible = CreateObject()
	customProperties.visible.collapse = true
	customProperties.visible.rules = CreateVisibilityRule("FruitSelection.answerCount()&gt;0")
	
	set customProperties.labels = CreateObject()
	set customProperties.labels.alternatives = CreateObject()
	set customProperties.labels.separator = ","
	
	for counter = 0 to fruitselection.Categories.Count -1
		set newProps = createObject()
		newProps.name = FruitSelection.Categories[counter].Name
		newProps.label =  FruitSelection.Categories[counter].Label
		newProps.block = false
		set newProps.visible = CreateObject()
		newProps.visible.collapse = true
		newProps.visible.rules = CreateVisibilityRule(MakeString("FruitSelection.containsAny('", FruitSelection.Categories[counter].Name, "')"))
		if propsAlternative is null then
			propsAlternative = jsonSerialize(newProps)
		else
			propsAlternative = MakeString(propsAlternative, ", ", jsonSerialize(newProps))
		end if
	next

	set customProperties.labels.alternatives = jsonDeSerialize(MakeString("[", propsAlternative, "]"))
	
	set customProperties.options = CreateObject()
	set customProperties.options.invisible = CreateObject()
	
	for counter = 0 to fruitselection.Categories.Count -1
		set newProps = CreateObject()
		newProps.name = FruitSelection.Categories[counter].Name
		newProps.rules = CreateVisibilityRule(MakeString("FruitSelection.containsNone('", FruitSelection.Categories[counter].Name, "')"))
		if propsOptions is null then
			propsOptions = jsonSerialize(newProps)
		else
			propsOptions = MakeString(propsOptions, ",", jsonSerialize(newProps))
		end if
	next

	set customProperties.options.invisible = jsonDeSerialize(MakeString("[", propsOptions, "]"))
		
	jsonProperties = JsonSerialize(customProperties)
	FruitFirst.Style.Color = jsonProperties
	
