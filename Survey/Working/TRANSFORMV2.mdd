	end with
	
	set yearCustomProperties = CreateObject()
	with yearCustomProperties 
	end with
	
	
	set iterationItem = ChildAgesMonthYear1Row[1]
	
	jsonProperties = JsonSerialize(monthCustomProperties)
	iterationItem["Month"].Style.Color = jsonProperties
	
	jsonProperties = JsonSerialize(yearCustomProperties)
	iterationItem["Year"].Style.Color = jsonProperties
	
	iterationItem["Year"].MustAnswer = false
	
'	PageToAsk.layouttemplate = "XML.htm"
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if
end section 

