dim textDirection
dim boolResetToNull

textDirection = ""
boolResetToNull = true

IOM.LayoutTemplate = MakeString("TabbedPage", textDirection, ".htm") 
IOM.QuestionTemplate = "Question.htm"
IOM.MustAnswer = false

set bannerPageProperties = IOM.Banners.AddNew("PageProperties", "")
set questionPageProperties = IOM.Questions["PageProperties"]
bannerPageProperties.style.BgColor="pageproperties:"
quote = ChrW(34)


Section SetPageProperties
	if questionPageProperties.response = null then
		set jsonPageProperties = CreateObject()
		
		Settings_ShowSeparator.response.initial = true
		Settings_Focus.response.initial = {Question, Control}
		Settings_SideBySide.response.initial = 35
		Settings_AllowPaste.response.initial = false
		Settings_JumptoFirstError.response.initial = true
		Settings_Validation.response.initial = true
		Settings_Float.Response.Initial = {float}
		Settings_ResetToNull.response = boolResetToNull
		Settings_Direction.Response = {LTR}
		
		with jsonPageProperties
			.validate = true
			.floatdetails = false
			.separator = true
			.sidebyside = 35
			set .focus = CreateObject()
			.focus.question = true
			.focus.control = true
			.paste = false
			.jumptoerror = true
			.tab = ""
			.resettonull = boolResetToNull
		end with
	
		questionPageProperties.Response = jsonSerialize(jsonPageProperties)
		UpdatePageProperties(IOM, questionPageProperties)
	end if
end section

section SetupTabStrip
debug.log(Makestring("setuptabstrip: [PageToDisplay]" , PageToDisplay.Response, " [Tabs]", Tabs.response))
	if PageToDisplay.Response is null then
		NextPage = "StripInstructions"
		NextTab = "StripInstructions"
	else
		NextPage = PageToDisplay.Response
		NextTab = TabToPage.Categories(NextPage).label.text
	end if
	set customProperties = CreateObject()
	set customProperties.onesize = CreateObject()
	customProperties.onesize.state = false
	
	jsonProperties = JsonSerialize(customProperties)
	Tabs.Style.Color = jsonProperties
	if Tabs.Response is null then
		Tabs.Response = {StripInstructions}
	end if
	
	StripOneSize.Response = {sizetofit}
    StripDisableTabs = {NoTabs}

	ShowTabStrip.Response.Initial = {Yes}
'	ShowTabStrip.Response = {No}
	ShowTabStrip.Ask()
	If ShowTabStrip.Response.containsAny({Yes}) then 
	    IOM.GlobalQuestions.Add(Tabs)
	end if
	boolResetToNull = (Settings_ResetToNull.response = true)
end section

