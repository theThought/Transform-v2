section VisibleReset
	dim resetvisibilityRule
	PageToDisplay.response = "ResetVisibilityPage"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

'PageToAsk.layouttemplate = "XML.htm"

	set customProperties = CreateObject()
	set customProperties.visible = CreateObject()

	resetvisibilityRule = CreateVisibilityRule("ResetChoice.containsAny('choicetext')")	
	with customProperties.visible
		.collapse = true
		.rules = resetvisibilityRule
	end with
	with customProperties
		.resettonull = boolResetToNull
	end with 
	jsonProperties = JsonSerialize(customProperties)
	choicetext.Style.Color = jsonProperties	

	resetvisibilityRule = CreateVisibilityRule("ResetChoice.containsAny('choicenumber')")	
	with customProperties.visible
		.rules = resetvisibilityRule
	end with
	with customProperties
		.resettonull = boolResetToNull	
	end with 
	jsonProperties = JsonSerialize(customProperties)
	choicenumber.Style.Color = jsonProperties	
	
	resetvisibilityRule = CreateVisibilityRule("ResetChoice.containsAny('choicedroplist')")	
	with customProperties.visible
		.rules = resetvisibilityRule
	end with
	with customProperties
		.jumptofirstletter = true
		.listsize = 10
		.resettonull = boolResetToNull
	end with
	jsonProperties = JsonSerialize(customProperties)
	choicedroplist.Style.Color = jsonProperties	

	resetvisibilityRule = CreateVisibilityRule("ResetChoice.containsAny('choicecombo')")	
	with customProperties.visible
		.rules = resetvisibilityRule
	end with
	with customProperties
		.filtertype = "contains"
		.listsize = 10
		.mincharactersforlist = 1
		.notenoughcharacters = "You need to type at least one character"
		.noitemsinlist = "no items match this filter"
		.resettonull = boolResetToNull
	end with
	
	jsonProperties = JsonSerialize(customProperties)
	choicecombo.Style.Color = jsonProperties	

	resetvisibilityRule = CreateVisibilityRule("ResetChoice.containsAny('choicesingle')")	
	with customProperties.visible
		.rules = resetvisibilityRule
	end with
	with customProperties
		.resettonull = boolResetToNull
	end with
	jsonProperties = JsonSerialize(customProperties)
	choicesingle.Style.Color = jsonProperties	

	resetvisibilityRule = CreateVisibilityRule("ResetChoice.containsAny('choicemulti')")	
	with customProperties.visible
		.rules = resetvisibilityRule
	end with
	with customProperties
		.resettonull = boolResetToNull
	end with
	jsonProperties = JsonSerialize(customProperties)
	choicemulti.Style.Color = jsonProperties	

	resetvisibilityRule = CreateVisibilityRule("ResetChoice.containsAny('choiceslider')")	
	with customProperties.visible
		.rules = resetvisibilityRule
	end with
	with customProperties
		.ticklabels  = 1
		.resettonull = boolResetToNull
	end with
	
	jsonProperties = JsonSerialize(customProperties)
	choiceslider.Style.Color = jsonProperties	

	choicetext.Response.Coded = null
	choicenumber.Response.Coded = null

	choicetext.response = "hello"
	choicenumber.Response = 5
	choicedroplist.Response = {second}
	choicecombo.Response = {fifth}
	choicesingle.Response = {eighth}
	choicemulti.Response = {eleventh}
	choiceslider.Response = 8

	choicetext.mustanswer = false
	choicenumber.mustanswer = false
	choicedroplist.mustanswer = false
	choicecombo.mustanswer = false
	choicesingle.mustanswer = false
	choicemulti.mustanswer = false
	choiceslider.mustanswer = false
			
	PageToAsk.ask()
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if 
end section

section eighthiddenopens
	PageToDisplay.response = "eighthiddenopens"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	set customProperties = createObject()
	set visibilityProperties = CreateObject()
	visibilityProperties.collapse = true
	previousName = ""
	iterationName = ""
	
	for each currentIteration in eighthiddenopens
		previousName = iterationName
		iterationName = currentIteration.QuestionName
		if previousName &lt;&gt; "" then
			currentRule = CreateVisibilityRule(MakeString("eighthiddenopens", "_Q", previousName, "_Qreason.answerCount() &gt; 0"))
			visibilityProperties.rules = currentRule
			set customProperties.visible = visibilityProperties
			jsonProperties = JsonSerialize(customProperties)
			
			currentIteration.reason.style.color = jsonProperties
		end if
		currentIteration.reason.MustAnswer = false
	next
	
'	PageToAsk.layouttemplate = "XML.htm"
	PageToAsk.ask()

	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if	
end section

