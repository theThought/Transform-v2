ue="10" type="3" context="Question"/></styles></property></DIFF></versions><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></styles><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">what a lovely light green colour this is, who would have thought</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">what a lovely light green colour this is, who would have thought</text></labels><versions><version name="105"><category name="lightgreen"/></version></versions></category><category id="_78ee9a98-424c-4675-b14f-90e84627677c" name="orange"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></DIFF></versions><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="Type" value="10" type="3" context="Question"/></DIFF></versions><property name="Type" value="10" type="3" context="Question"/></styles></property></styles><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">orange</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">orange</text></labels><versions><version name="105"><category name="orange"/></version></versions></category></categories><variable id="45decb8a-fb43-4a1e-8b2a-57de5812a6e0" name="TransformIntro" type="0"><notes><versions><DIFF OP="ADD" name="105" Index="0"><property name="5@note1" value="------------------------" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="105" Index="1"><property name="5@note2" value=" Instructions" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="105" Index="2"><property name="5@note3" value="========================" type="8" context="Question"/></DIFF></versions><property name="5@note1" value="------------------------" type="8" context="Question"/><property name="5@note2" value=" Instructions" type="8" context="Question"/><property name="5@note3" value="========================" type="8" context="Question"/></notes><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;The Transform Initiative&lt;/h2&gt;&lt;p&gt;This survey provides a demonstration of the latest look and feel for Healthcare studies.  It utilises a tab strip for easy naviation while also allowing traditional Next/Previous linear transition&lt;/p&gt;&lt;p&gt;All the response types shown are built using a modern design system.  This is modular and whitelabel aware, while the skin applied is an Ipsos colour scheme it can be transformed into any branding easily.&lt;/p&gt;&lt;p&gt;All the content is accessible.  Accessibility has been considered and checked at every step.  This is not onlly with a view to passing an automated WorldWide Consortium Accessibility Group (WCAG) regulations to the AA standard, but also to provide practical screen reader support&lt;/p&gt;</text></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;The Transform Initiative&lt;/h2&gt;&lt;p&gt;This survey provides a demonstration of the latest look and feel for Healthcare studies.  It utilises a tab strip for easy naviation while also allowing traditional Next/Previous linear transition&lt;/p&gt;&lt;p&gt;All the response types shown are built using a modern design system.  This is modular and whitelabel aware, while the skin applied is an Ipsos colour scheme it can be transformed into any branding easily.&lt;/p&gt;&lt;p&gt;All the content is accessible.  Accessibility has been considered and checked at every step.  This is not onlly with a view to passing an automated WorldWide Consortium Accessibility Group (WCAG) regulations to the AA standard, but also to provide practical screen reader support&lt;/p&gt;&lt;h2&gt;Using Tabstrips&lt;/h2&gt;&lt;p&gt;This is Tabstrip 1, its purpose is to provide an alternative method of navigation between survey pages.  It can be used in conjunction with traditional navigation buttons (next/previous) or it can replace them entirely.&lt;/p&gt;&lt;p&gt;The tabstrip is based on a choice question (single-answer).  When a user taps on a tab they select that option in the question.  The form is then sumbitted and Dimensions uses the selection to determine the next page to visit.&lt;/p&gt;&lt;p&gt; In situations where the user views a page, fails to complete mandatory questions and then clicks on another tab to move away, the solution will look at the location of the new tab compared to the current one.  If the new tab is to the left it uses the previous button to navigate away.  If it is to the right it uses the next button; this causes validation to occur and for the user to be returned to the original tab to complete the required actions.&lt;/p&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;h2&gt;The Transform Initiative&lt;/h2&gt;&lt;p&gt;This survey provides a demonstration of the latest look and feel for Healthcare studies.  It utilises a tab strip for easy naviation while also allowing traditional Next/Previous linear transition&lt;/p&gt;&lt;p&gt;All the response types shown are built using a modern design system.  This is modular and whitelabel aware, while the skin applied is an Ipsos colour scheme it can be transformed into any branding easily.&lt;/p&gt;&lt;p&gt;All the content is accessible.  Accessibility has been considered and checked at every step.  This is not onlly with a view to passing an automated WorldWide Consortium Accessibility Group (WCAG) regulations to the AA standard, but also to provide practical screen reader support&lt;/p&gt;&lt;h2&gt;Using Tabstrips&lt;/h2&gt;&lt;p&gt;This is Tabstrip 1, its purpose is to provide an alternative method of navigation between survey pages.  It can be used in conjunction with traditional navigation buttons (next/previous) or it can replace them entirely.&lt;/p&gt;&lt;p&gt;The tabstrip is based on a choice question (single-answer).  When a user taps on a tab they select that option in the question.  The form is then sumbitted and Dimensions uses the selection to determine the next page to visit.&lt;/p&gt;&lt;p&gt; In situations where the user views a page, fails to complete mandatory questions and then clicks on another tab to move away, the solution will look at the location of the new tab compared to the current one.  If the new tab is to the left it uses the previous button to navigate away.  If it is to the right it uses the next button; this causes validation to occur and for the user to be returned to the original tab to complete the required actions.&lt;/p&gt;</text></labels><versions><version name="105"><variable name="TransformIntro" type="0"/></version></versions><properties><versions><DIFF OP="ADD" name="105" Index="0"><property name="CurrentTab" value="Introduction" type="8" context="Question"/></DIFF></versions><property name="CurrentTab" value="Introduction" type="8" context="Question"/></properties><templates><versions><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question.htm" type="8" context="Question"/></templates></variable><variable id="b0c17bbd-b4b6-42c9-90c4-662f07a51648" name="InformationInstructions" type="0"><properties><versions><DIFF OP="ADD" name="105" Index="0"><property name="CurrentTab" value="Information" type="8" context="Question"/></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><property name="CurrentTab" value="Presenting" type="8" context="Question"/></DIFF></versions><property name="CurrentTab" value="Presenting" type="8" context="Question"/></properties><templates><versions><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question.htm" type="8" context="Question"/></templates><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;p&gt;Not all questions ask questions; some questions present information to the respondent.&lt;/p&gt;&lt;p&gt;information questions can be standalone or can be used in conjunction with other interactive questions on the page. It is also possible to combine presenting and answering in a single question where the presenting functionality is part of the question text.&lt;/p&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;p&gt;Not all questions ask questions; some questions present information to the respondent.&lt;/p&gt;&lt;p&gt;information questions can be standalone or can be used in conjunction with other interactive questions on the page. It is also possible to combine presenting and answering in a single question where the presenting functionality is part of the question text.&lt;/p&gt;</text></labels><versions><version name="105"><variable name="InformationInstructions" type="0"/></version></versions></variable><variable id="fa37f378-efe8-4220-940c-9f21ba386da9" name="ReadOS" type="2" min="0" mintype="3" max="100" maxtype="3"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="BgColor" value="singleline:" type="8" context="Question"/></DIFF></versions><property name="BgColor" value="singleline:" type="8" context="Question"/></styles><notes><versions><DIFF OP="ADD" name="105" Index="0"><property name="5@note1" value="---------------------------" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="105" Index="1"><property name="5@note2" value=" Read/Write Local storage" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="105" Index="2"><property name="5@note3" value="===========================" type="8" context="Question"/></DIFF></versions><property name="5@note1" value="---------------------------" type="8" context="Question"/><property name="5@note2" value=" Read/Write Local storage" type="8" context="Question"/><property name="5@note3" value="===========================" type="8" context="Question"/></notes><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">Operating System:</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Operating System:</text></labels><versions><version name="105"><variable name="ReadOS" type="2" min="0" mintype="3" max="100" maxtype="3"/></version></versions><templates><versions><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="question 2-column.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question 2-column.htm" type="8" context="Question"/></templates></variable><variable id="be42989d-9d69-40a5-a4f4-956fcf8b82dd" name="ReadBrowser" type="2" min="0" mintype="3" max="300" maxtype="3"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="BgColor" value="singleline:" type="8" context="Question"/></DIFF></versions><property name="BgColor" value="singleline:" type="8" context="Question"/></styles><labels context="LABEL"><versions><DIFF OP="ADD" name="105" Index="0"><text context="QUESTION" xml:lang="en-US">Browser:</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">Browser:</text></labels><versions><version name="105"><variable name="ReadBrowser" type="2" min="0" mintype="3" max="300" maxtype="3"/></version></versions><templates><versions><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="que