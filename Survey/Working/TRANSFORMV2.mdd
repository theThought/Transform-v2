Section Settings
dim focusSettings
	PageToDisplay.response = "PageConfiguration"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)
	
	IOM.Title = "Page Properties"
'	IOM.LayoutTemplate = "xml.htm"
	PageToAsk.ask()
	
	ChangePageProperties(IOM, questionPageProperties, MakeString("separator=", CText(Settings_ShowSeparator.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("floatdetails=", Settings_Float.containsAny("float")), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("validate=", CText(Settings_Validation.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("paste=", CText(Settings_AllowPaste.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("jumptoerror=", CText(Settings_ShowSeparator.response)), false)
	ChangePageProperties(IOM, questionPageProperties, MakeString("sidebyside=", CText(Settings_SideBySide.response)), false)
	if Settings_Focus.Response.containsAny("question") then 
		ChangePageProperties(IOM, questionPageProperties, "focus.question=true", false)
	else
		ChangePageProperties(IOM, questionPageProperties, "focus.question=false", false)	
	end if
	if Settings_Focus.Response.containsAny("control") then 
		ChangePageProperties(IOM, questionPageProperties, "focus.control=true", false)
	else
		ChangePageProperties(IOM, questionPageProperties, "focus.control=false", false)	
	end if
	
	UpdatePageProperties(IOM, questionPageProperties)
	set customProperties = CreateObject()
	set customProperties.balance = CreateObject()
	customProperties.balance.state = true
	
	set customProperties.onesize = CreateObject()
	customProperties.onesize.state = StripOneSize.Response.containsAny("sizetofit")

	jsonProperties = JsonSerialize(customProperties)
	tabs.Style.Color = jsonProperties

	if Settings_Direction.response.ContainsAny("LTR") then 
		textDirection = ""
	else
		textDirection = "RTL"
	end if
	boolResettoNull = (Settings_Resettonull.Response = true)
	
	if ShowTabStrip.Response.containsAny("yes") then
		IOM.LayoutTemplate = MakeString("TabbedPage", textDirection, ".htm")
	else
		IOM.LayoutTemplate = MakeString("Page", textDirection, ".htm")
	end if
	
'	IOM.LayoutTemplate = "xml.htm"
	
	if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if

end section

