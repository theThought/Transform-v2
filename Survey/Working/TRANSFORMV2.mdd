	CreateInformationPopup(WhichQuestion, "Configuration", "&lt;p&gt;Various custom properties can be provided to adjust the configuration of a question.&lt;/p&gt;&lt;p&gt;each question can have its own information content&lt;/p&gt;")
	CreateInformationPopup(HowMany1, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	CreateInformationPopup(HowMany2, "Configuration", "Various custom properties can be provided to adjust the configuration of a question")
	
	set customProperties = CreateObject()
