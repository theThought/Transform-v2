section PageGridotherspecify
	PageToDisplay.response = "PageGridotherspecify"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

	gridotherspecify[..].thedropdown.MustAnswer = false
	gridotherspecify[..].theinput.MustAnswer = false
	
	set customProperties = CreateObject()
	set visibilityProperties = CreateObject()
	visibilityProperties.collapse = true
	currentRule = CreateVisibilityRule("HideGridOtherSpecify.containsAny('Yes')")
	visibilityProperties.rules = currentRule
	customProperties.visible = visibilityProperties
	jsonProperties = JsonSerialize(customProperties)
	GridOtherSpecify.Style.Color = jsonProperties
	
	previousName = ""
	for each currentIteration in gridotherspecify
		iterationName = currentIteration.QuestionName
'		previousName = iterationName
		set customProperties = CreateObject() 
		
		with customProperties
		 .listsize = 10
		 .filtertype = "starts"
		 .noiteminlist = "nothing starts that way"
		end with
		if previousName &lt;&gt; "" then
			set visibilityProperties = CreateObject()
			visibilityProperties.collapse = true
			currentRule = CreateVisibilityRule(MakeString("gridotherspecify", "_Q", previousName, "_Qthedropdown.answerCount()&gt;0 and HideGridOtherSpecify.containsAny('Yes')"))
			visibilityProperties.rules = currentRule
			customProperties.visible = visibilityProperties
		else
			set visibilityProperties = CreateObject()
			visibilityProperties.collapse = true
			currentRule = CreateVisibilityRule(MakeString("gridotherspecify.isVisible()"))
			visibilityProperties.rules = currentRule
			customProperties.visible = visibilityProperties		
		end if
		
		jsonProperties = JsonSerialize(customProperties)
		currentIteration.theDropdown.style.color = jsonProperties
		
		set customProperties = CreateObject() 
		set visibilityProperties = CreateObject()
		visibilityProperties.collapse = true
		
		currentRule = CreateVisibilityRule(MakeString("gridotherspecify", "_Q", iterationName, "_Qthedropdown.containsAny('otheroption')"))
		visibilityProperties.rules = currentRule
		set customProperties.visible = visibilityProperties
		jsonProperties = JsonSerialize(customProperties)
		
		currentIteration.theInput.style.color = jsonProperties
		previousName = iterationName
	next
	
'	PageToAsk.layouttemplate = "XML.htm"
	PageToAsk.ask()
		if nextPage &lt;&gt; "" then
		Goto JumpBackwards
	end if	
end section
