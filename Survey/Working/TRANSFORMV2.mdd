	sundayRule = CreateVisibilityRule("PaperTypes.containsAny('Sunday')")
	internationalRule = CreateVisibilityRule("PaperTypes.containsAny('International')")
	
	set customProperties = CreateObject()
	with customProperties
		set .balance = CreateObject()
		.balance.state = true
		set .onesize = CreateObject()
		.onesize.state = true
		set .options = CreateObject()
		set .options.visible = CreateObject()
	end with
	
	for optionRulesCounter = 0 to 16
		set optionsArray[optionRulesCounter] = CreateObject()
	Next
	
