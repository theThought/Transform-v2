section Tabletotals

section PainRelief
	dim topHeadings, visibilityRule

	PageToDisplay.response = "PainReliefPage"
	set PageToAsk = SetPageToAsk(IOM, PageToDisplay, Tabs, TabFilters)

'AddCustomProperties(PainRelief, "PainRelief", "{'caption':{'content':'Pain Relief'},'totals':{'rows':{'visible':true,'caption':{'content':'Consumption'},'exceptions':[]},'columns':{'visible':false,'exceptions':[1]}}}", "replace")
'AddCustomProperties(PainRelief, "dosesgiven", "{'type':'number'}", "add")
'AddCustomProperties(PainRelief, "Monday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Tuesday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Wednesday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Thursday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Friday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Saturday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "Sunday", "{'type':'number','showspinner':true}", "add")
'AddCustomProperties(PainRelief, "PainRelief", "{'topheadings':[{'caption':'','colspan':1},{'caption':'Week','colspan':5},{'caption':'Weekend','colspan':2},{'caption':'Total','colspan':1}]}", "add")

	topHeadings = "{'topheadings':[{'caption':'','colspan':2},{'caption':'Week','colspan':5},{'caption':'Weekend','colspan':2},{'caption':'Total','colspan':1}]}"
	topHeadings = topHeadings.replace("'", """")

	visibilityRule = CreateVisibilityRule("OfferPainRelief.containsAny('Yes')")
	set customProperties = CreateObject()
	set customProperties.labels = CreateObject()
	customProperties.labels.pre = "definitely won't"
	customProperties.labels.post = "definitely will"
	set customProperties.visible = CreateObject()
	with customProperties.visible
		.collapse = true
		.rules = visibilityRule
	end with

	jsonProperties = JsonSerialize(customProperties)
	FuturePainRelief.Style.Color = jsonProperties
	FuturePainRelief.MustAnswer = false
	
	set customProperties = CreateObject()
	set customProperties.balance = CreateObject()
	customProperties.balance.state = true
	
	jsonProperties = JsonSerialize(customProperties)
	OfferPainRelief.style.color = jsonProperties
	OfferPainRelief.Response.Initial = {Yes}
		
	set customProperties = CreateObject()
	set customProperties.showspinner = true
	jsonProperties = JsonSerialize(customProperties)

