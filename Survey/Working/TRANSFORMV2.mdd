" context="Question"/></DIFF></versions><property name="CurrentTab" value="FormInstructions" type="8" context="Question"/></properties><styles><versions><DIFF OP="ADD" name="80" Index="0"><property name="BgColor" value="information:" type="8" context="Question"/></DIFF></versions><property name="BgColor" value="information:" type="8" context="Question"/></styles><templates><versions><DIFF OP="ADD" name="80" Index="0"><property name="Question" value="question.htm" type="8" context="Question"/></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><property name="Question" value="question zero.htm" type="8" context="Question"/></DIFF></versions><property name="Question" value="question zero.htm" type="8" context="Question"/></templates><notes><versions><DIFF OP="ADD" name="80" Index="0"><property name="5@note1" value="------------------------" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="80" Index="1"><property name="5@note2" value=" Forms" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="80" Index="2"><property name="5@note3" value="========================" type="8" context="Question"/></DIFF></versions><property name="5@note1" value="------------------------" type="8" context="Question"/><property name="5@note2" value=" Forms" type="8" context="Question"/><property name="5@note3" value="========================" type="8" context="Question"/></notes><labels context="LABEL"><versions><DIFF OP="ADD" name="80" Index="0"><text context="QUESTION" xml:lang="en-US">&lt;b&gt;Forms are a new way to create complex questions&lt;/b&gt;&lt;br /&gt;&lt;p&gt;Complex questions are two or more related questions that combined together make a single answer.  For example a date might be expressed as a combination of month and year with the month selected from a list and year entered as a value.  The combination of the two inputs makes the date.&lt;/p&gt;&lt;p&gt;Forms may just require a single answer but want to ensure that all inputs are provided for that answer or they may be a way of providing multiple answers with a single point of entry.  In the latter case a form may have only one input rather than two or more as the form is simply a way of obtaining a single point of entry&lt;/p&gt;</text></DIFF></versions><text context="QUESTION" xml:lang="en-US">&lt;b&gt;Forms are a new way to create complex questions&lt;/b&gt;&lt;br /&gt;&lt;p&gt;Complex questions are two or more related questions that combined together make a single answer.  For example a date might be expressed as a combination of month and year with the month selected from a list and year entered as a value.  The combination of the two inputs makes the date.&lt;/p&gt;&lt;p&gt;Forms may just require a single answer but want to ensure that all inputs are provided for that answer or they may be a way of providing multiple answers with a single point of entry.  In the latter case a form may have only one input rather than two or more as the form is simply a way of obtaining a single point of entry&lt;/p&gt;</text></labels><versions><version name="80"><variable name="FormInstructions" type="0"/></version></versions></variable><variable id="1ba2623f-b2c9-4d62-bc87-9c9b52d85d98" name="twodecimal" type="6" min="0.01" mintype="5" max="100" maxtype="5" rangeexp="[0.01 .. 100]"><styles><versions><DIFF OP="ADD" name="81" Index="0"><property name="BgColor" value="singleline-number:" type="8" context="Question"/></DIFF><DIFF OP="ADD" name="81" Index="1"><property name="Width" value="5em" type="8" context="Question"/></DIFF><DIFF OP="DEL" name="105" Index="0"/><DIFF OP="ADD" name="105" Index="0"><property name="Control" type="9" context="Question"><styles><versions><DIFF OP="ADD" name="105" Index="0"><property name="ReadOnly" value="-1" type="11" context="Question"/></DIFF></versions><property name="ReadOnly" value="-1" type="11" context="Question"/></styles></property></DIFF><DIFF OP="DEL" name="105" Index="1"/><DIFF OP="ADD" name="105" Index="1"><prope